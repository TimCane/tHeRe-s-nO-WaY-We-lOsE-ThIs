---
import Layout from '../layouts/Layout.astro';

const players = [
  {
    name: "DOODLLEUS",
    tag: "DOODLLEUS",
    role: "Duelist",
    agents: "Reyna / Neon",
    quote: "Sploink?",
    image: "/assets/E8a1_Cineposter_4x5_IG.jpg",
    accent: "#c742f5",
    slug: "doodlleus",
    stats: { kd: "0.96", hs: "19.3%", wr: "49.3%" }
  },
  {
    name: "TJC",
    tag: "TJC",
    role: "Support / Controller",
    agents: "Sage / Viper",
    quote: "Ah yep -- classic.",
    image: "/assets/FirstLook_SageHealConcept.jpg",
    accent: "#17ecc2",
    slug: "tjc",
    stats: { kd: "1.01", hs: "17.8%", wr: "51.2%" }
  },
  {
    name: "PRETTY MOUTH BOY",
    tag: "PRETTYMOUTHBOY",
    role: "Controller",
    agents: "Brimstone",
    quote: "Not a gamer anymore.",
    image: "/assets/FirstLook_ClassicRevolverConcept_VALORANT.jpg",
    accent: "#f5a623",
    slug: "prettymouthboy",
    stats: { kd: "0.90", hs: "13.5%", wr: "48.2%" }
  },
  {
    name: "GOOD CHILL NIGHT",
    tag: "GOODCHILLNIGHT",
    role: "Sentinel",
    agents: "Killjoy",
    quote: "Only 1.",
    image: "/assets/VALORANT_Deadlock_Wallpapers_4k_Dark2.jpg",
    accent: "#f5d623",
    slug: "goodchillnight",
    stats: { kd: "???", hs: "???", wr: "???" }
  },
  {
    name: "NEILATRON",
    tag: "NEILATRON",
    role: "Flex / Initiator",
    agents: "Gekko / Clove / Raze",
    quote: "Im up for losing some rr.",
    image: "/assets/Gekko_Dark_1.png",
    accent: "#7aff4a",
    slug: "neilatron",
    stats: { kd: "0.96", hs: "12.9%", wr: "49.1%" }
  },
];
---

<Layout title="tHeRe's nO WaY We lOsE ThIs™">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <img src="/assets/Ep_7_Keyart_4k.jpg" alt="Valorant Key Art" />
      <div class="hero-overlay"></div>
      <div class="scanlines"></div>
      <div class="hero-noise"></div>
    </div>
    <div class="hero-content">
      <div class="hero-tag">
        <span class="tag-dot"></span>
        TEAM ROSTER // EST. 2020
        <span class="tag-dot"></span>
      </div>
      <h1 class="glitch" data-text="tHeRe's nO WaY We lOsE ThIs™">tHeRe's nO WaY We lOsE ThIs&#8482;</h1>
      <p class="hero-sub">tHeRe's nO WaY We lOsE ThIs&#8482;</p>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-num count-up" data-target="5">0</span>
          <span class="stat-label">PLAYERS</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-num">GOLD</span>
          <span class="stat-label">AVG RANK</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="stat-num count-up" data-target="49" data-suffix="%">0%</span>
          <span class="stat-label">WIN RATE</span>
        </div>
      </div>
      <a href="#roster" class="hero-cta">MEET THE SQUAD</a>
    </div>
    <div class="scroll-indicator">
      <div class="scroll-line"></div>
      <span>SCROLL</span>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about" id="about">
    <div class="section-header">
      <span class="section-tag">// 001</span>
      <h2>THE VIBE</h2>
    </div>
    <div class="about-grid">
      <div class="about-text">
        <p class="about-lead">We're not good. But we're here. And we're not leaving. Purchance.</p>
        <p>It always starts the same way: Doodlleus drops a 'Sploink?' or a 'Chimchimcheroo?' in the group chat. Neilatron says 'Aye.' TJC says 'I could do exactly one.' Pretty Mouth Boy says he's not a gamer anymore, then queues up anyway. Good Chill Night says 'Mayb.' Five players. One of us is in Factorio. One of us is asleep. One of us is dying in enemy spawn. One of us is an AI pretending to be human. One of us has never gotten an ace. The gaming chair loses power at 11pm. Nobody has learned a lineup. Everyone buys Odins just to watch the enemy team moan in chat. But somehow? tHeRe's nO WaY We lOsE ThIs&#8482;.</p>
        <div class="about-values">
          <div class="value">
            <span class="value-icon">&#9670;</span>
            <span>GAMING CHAIR POWER EXPIRES AT 11PM</span>
          </div>
          <div class="value">
            <span class="value-icon">&#9670;</span>
            <span>WHEN WE LOSE, WE BLAME GOOD CHILL NIGHT</span>
          </div>
          <div class="value">
            <span class="value-icon">&#9670;</span>
            <span>PRETTY MOUTH BOY DIES FIRST (FACTORIO)</span>
          </div>
          <div class="value">
            <span class="value-icon">&#9670;</span>
            <span>ODIN EVERY ROUND (CRY ABOUT IT)</span>
          </div>
        </div>
      </div>
      <div class="about-image">
        <img src="/assets/Ep8A1_Riot Games.com Product Card 1920x1080_.jpg" alt="Team vibes" />
        <div class="about-image-accent"></div>
      </div>
    </div>
  </section>

  <!-- ROSTER -->
  <section class="roster" id="roster">
    <div class="section-header">
      <span class="section-tag">// 002</span>
      <h2>THE ROSTER</h2>
    </div>
    <div class="player-grid">
      {players.map((player, i) => (
        <a href={`/players/${player.slug}`} class={`player-card ability-${player.slug}`} style={`--accent: ${player.accent}; --delay: ${i * 0.1}s`}>
          <div class="card-image">
            <img src={player.image} alt={player.name} />
            <div class="card-overlay"></div>
            <div class="ability-fx"></div>
          </div>
          <div class="card-rank">{player.rank}</div>
          <div class="card-content">
            <div class="card-role">{player.agents}</div>
            <h3 class="card-name">{player.name}</h3>
            <div class="card-tag">{player.role}</div>
            <div class="card-stats">
              <span>{player.stats.kd} K/D</span>
              <span>{player.stats.hs} HS</span>
              <span>{player.stats.wr} WR</span>
            </div>
          </div>
          <div class="card-arrow">&rarr;</div>
        </a>
      ))}
    </div>
  </section>

  <!-- QUOTE TICKER -->
  <div class="ticker">
    <div class="ticker-track">
      <span>"Sploink?"</span>
      <span>&#9670;</span>
      <span>"Aye"</span>
      <span>&#9670;</span>
      <span>"purchance"</span>
      <span>&#9670;</span>
      <span>"CRASHOUT"</span>
      <span>&#9670;</span>
      <span>"That's a brimjob"</span>
      <span>&#9670;</span>
      <span>"Only 1"</span>
      <span>&#9670;</span>
      <span>"This is why im the viper"</span>
      <span>&#9670;</span>
      <span>"Im up for losing some rr"</span>
      <span>&#9670;</span>
      <span>"Not a gamer anymore"</span>
      <span>&#9670;</span>
      <span>"Mayb"</span>
      <span>&#9670;</span>
      <span>"I could do exactly one"</span>
      <span>&#9670;</span>
      <span>"Chimchimcheroo?"</span>
      <span>&#9670;</span>
      <span>"Oingoboingo?"</span>
      <span>&#9670;</span>
      <span>"Boom boom pow?"</span>
      <span>&#9670;</span>
      <span>"Sploink?"</span>
      <span>&#9670;</span>
      <span>"Aye"</span>
      <span>&#9670;</span>
      <span>"purchance"</span>
      <span>&#9670;</span>
      <span>"CRASHOUT"</span>
      <span>&#9670;</span>
      <span>"That's a brimjob"</span>
      <span>&#9670;</span>
      <span>"Only 1"</span>
      <span>&#9670;</span>
      <span>"This is why im the viper"</span>
      <span>&#9670;</span>
      <span>"Im up for losing some rr"</span>
      <span>&#9670;</span>
      <span>"Not a gamer anymore"</span>
      <span>&#9670;</span>
      <span>"Mayb"</span>
      <span>&#9670;</span>
      <span>"I could do exactly one"</span>
      <span>&#9670;</span>
      <span>"Chimchimcheroo?"</span>
      <span>&#9670;</span>
      <span>"Oingoboingo?"</span>
      <span>&#9670;</span>
      <span>"Boom boom pow?"</span>
      <span>&#9670;</span>
    </div>
  </div>

  <!-- WILL THEY PLAY TONIGHT -->
  <section class="flowchart" id="flowchart">
    <div class="section-header">
      <span class="section-tag">// 003</span>
      <h2>WILL THEY PLAY TONIGHT?</h2>
    </div>
    <div class="flow-grid">
      <div class="flow-card" style="--accent: #c742f5">
        <h3>DOODLLEUS</h3>
        <div class="flow-steps">
          <div class="flow-step">Drops "Sploink?" in chat</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">Sorts Calpol for kiddo</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">Makes coffee</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step result yes">ALWAYS YES</div>
          <div class="flow-note">* gaming chair expires at 11pm</div>
        </div>
      </div>
      <div class="flow-card" style="--accent: #17ecc2">
        <h3>TJC</h3>
        <div class="flow-steps">
          <div class="flow-step">"I need a minute to think"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">Gets off sofa</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">"I could do exactly one"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step result maybe">PLAYS 4</div>
          <div class="flow-note">* may fall asleep mid-queue</div>
        </div>
      </div>
      <div class="flow-card" style="--accent: #f5a623">
        <h3>PRETTY MOUTH BOY</h3>
        <div class="flow-steps">
          <div class="flow-step">"Not a gamer anymore"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">Good Chill Night answers for him</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">"purchance"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step result yes">QUEUES UP ANYWAY</div>
          <div class="flow-note">* Factorio running on 2nd monitor</div>
        </div>
      </div>
      <div class="flow-card" style="--accent: #f5d623">
        <h3>GOOD CHILL NIGHT</h3>
        <div class="flow-steps">
          <div class="flow-step">"Mayb"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">"Mayhaps"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">"Only 1"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step result maybe">YES (EVENTUALLY)</div>
          <div class="flow-note">* ace still pending</div>
        </div>
      </div>
      <div class="flow-card" style="--accent: #7aff4a">
        <h3>NEILATRON</h3>
        <div class="flow-steps">
          <div class="flow-step">"Aye"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">"I could be persuaded"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step">"Im up for losing some rr"</div>
          <div class="flow-arrow">&darr;</div>
          <div class="flow-step result yes">AYE</div>
          <div class="flow-note">* may fall asleep before lobby</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM STATS COMPARISON -->
  <section class="comparison" id="stats">
    <div class="section-header">
      <span class="section-tag">// 004</span>
      <h2>THE NUMBERS DON'T LIE</h2>
    </div>
    <p class="comparison-sub">(but they do hurt)</p>
    <div class="compare-table">
      <div class="compare-header">
        <div class="compare-cell label"></div>
        <div class="compare-cell">K/D</div>
        <div class="compare-cell">HS%</div>
        <div class="compare-cell">WIN%</div>
        <div class="compare-cell">RANK</div>
      </div>
      <div class="compare-row" style="--accent: #17ecc2">
        <div class="compare-cell label">TJC</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 84%"></span></span>1.01</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 69%"></span></span>17.8%</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 100%"></span></span>51.2%</div>
        <div class="compare-cell rank-cell">Gold 2</div>
      </div>
      <div class="compare-row" style="--accent: #c742f5">
        <div class="compare-cell label">DOODLLEUS</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 80%"></span></span>0.96</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 75%"></span></span>19.3%</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 95%"></span></span>49.3%</div>
        <div class="compare-cell rank-cell">Gold 3</div>
      </div>
      <div class="compare-row" style="--accent: #7aff4a">
        <div class="compare-cell label">NEILATRON</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 80%"></span></span>0.96</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 50%"></span></span>12.9%</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 94%"></span></span>49.1%</div>
        <div class="compare-cell rank-cell">Gold 3</div>
      </div>
      <div class="compare-row" style="--accent: #f5a623">
        <div class="compare-cell label">PRETTY MOUTH BOY</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 75%"></span></span>0.90</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 52%"></span></span>13.5%</div>
        <div class="compare-cell"><span class="bar-wrap"><span class="bar" style="width: 92%"></span></span>48.2%</div>
        <div class="compare-cell rank-cell">Gold 3</div>
      </div>
      <div class="compare-row" style="--accent: #f5d623">
        <div class="compare-cell label">GOOD CHILL NIGHT</div>
        <div class="compare-cell">???</div>
        <div class="compare-cell">???</div>
        <div class="compare-cell">???</div>
        <div class="compare-cell rank-cell">HIDDEN</div>
      </div>
    </div>
  </section>

  <!-- ODIN WALL OF SHAME -->
  <section class="odin-wall">
    <div class="section-header">
      <span class="section-tag">// 005</span>
      <h2>THE ODIN PROTOCOL</h2>
    </div>
    <p class="odin-sub">We buy Odins. They cry in chat. This is the way.</p>
    <div class="odin-grid">
      <div class="odin-msg enemy">
        <span class="msg-tag">[ALL] enemy_jett:</span> odin really?
      </div>
      <div class="odin-msg enemy">
        <span class="msg-tag">[ALL] xX_Reyna_Xx:</span> 5 odins is crazy
      </div>
      <div class="odin-msg team">
        <span class="msg-tag">[TEAM] DOODLLEUS:</span> Sploink?
      </div>
      <div class="odin-msg enemy">
        <span class="msg-tag">[ALL] sage_main_99:</span> this is so disrespectful
      </div>
      <div class="odin-msg team">
        <span class="msg-tag">[TEAM] TJC:</span> This is why im the viper
      </div>
      <div class="odin-msg enemy">
        <span class="msg-tag">[ALL] ttv_phoenix:</span> reported all 5
      </div>
      <div class="odin-msg team">
        <span class="msg-tag">[TEAM] NEILATRON:</span> Aye
      </div>
      <div class="odin-msg enemy">
        <span class="msg-tag">[ALL] killjoy420:</span> wallbang odin is NOT skill
      </div>
      <div class="odin-msg team">
        <span class="msg-tag">[TEAM] PRETTY MOUTH BOY:</span> purchance
      </div>
      <div class="odin-msg enemy">
        <span class="msg-tag">[ALL] enemy_omen:</span> how is this fun for you
      </div>
      <div class="odin-msg team">
        <span class="msg-tag">[TEAM] GOOD CHILL NIGHT:</span> Mayb
      </div>
      <div class="odin-msg enemy">
        <span class="msg-tag">[ALL] raze_diff:</span> im not playing this game anymore
      </div>
    </div>
  </section>

  <!-- ACE WATCH -->
  <section class="ace-watch" id="acewatch">
    <div class="ace-content">
      <span class="section-tag">// 006</span>
      <h2>THE ACE WATCH</h2>
      <p class="ace-subtitle">GOOD CHILL NIGHT'S FIRST ACE</p>
      <div class="ace-counter">
        <div class="ace-stat">
          <span class="ace-num count-up" id="days-count" data-target="0">0</span>
          <span class="ace-label">DAYS SINCE<br/>SQUAD FORMED</span>
        </div>
        <div class="ace-divider"></div>
        <div class="ace-stat">
          <span class="ace-num count-up" data-target="0">0</span>
          <span class="ace-label">ACES<br/>ACHIEVED</span>
        </div>
        <div class="ace-divider"></div>
        <div class="ace-stat">
          <span class="ace-num">&infin;</span>
          <span class="ace-label">HOPE<br/>REMAINING</span>
        </div>
      </div>
      <p class="ace-quote">"Look me in the eyes and tell me you believe that."</p>
      <p class="ace-attribution">— GOOD CHILL NIGHT, when told tonight could be the night</p>
    </div>
  </section>

  <script>
    const start = new Date('2020-07-01');
    const now = new Date();
    const days = Math.floor((now.getTime() - start.getTime()) / (1000 * 60 * 60 * 24));
    const el = document.getElementById('days-count');
    if (el) {
      el.dataset.target = days.toString();
    }
  </script>

  <!-- WHY WE LOST EXCUSE GENERATOR -->
  <section class="excuse-gen" id="excuses">
    <div class="section-header">
      <span class="section-tag">// WHY WE LOST</span>
      <h2>EXCUSE GENERATOR</h2>
    </div>
    <div class="excuse-display">
      <p class="excuse-text glitch-text" id="excuse-text">Press the button. You know you need one.</p>
    </div>
    <button class="excuse-btn" id="excuse-btn">GENERATE EXCUSE</button>
  </section>

  <!-- MATCH HISTORY -->
  <section class="match-history" id="matchhistory">
    <div class="section-header">
      <span class="section-tag">// MATCH HISTORY</span>
      <h2>RECENT MATCHES</h2>
    </div>
    <div class="match-list">
      <div class="match-entry win">
        <span class="match-map">LOTUS</span>
        <span class="match-score">13-7</span>
        <span class="match-result">W</span>
        <span class="match-comment">"The 4-knife round. We peaked."</span>
      </div>
      <div class="match-entry loss">
        <span class="match-map">ASCENT</span>
        <span class="match-score">5-13</span>
        <span class="match-result">L</span>
        <span class="match-comment">"Pretty Mouth Boy was in Factorio for 9 rounds."</span>
      </div>
      <div class="match-entry win">
        <span class="match-map">BIND</span>
        <span class="match-score">13-11</span>
        <span class="match-result">W</span>
        <span class="match-comment">"Odin protocol activated. Enemy team in shambles."</span>
      </div>
      <div class="match-entry loss">
        <span class="match-map">HAVEN</span>
        <span class="match-score">2-13</span>
        <span class="match-result">L</span>
        <span class="match-comment">"Nobody wanted to play but Doodlleus said 'Sploink?'"</span>
      </div>
      <div class="match-entry loss">
        <span class="match-map">ICEBOX</span>
        <span class="match-score">8-13</span>
        <span class="match-result">L</span>
        <span class="match-comment">"TJC bait rez'd 4 times. All died."</span>
      </div>
      <div class="match-entry win">
        <span class="match-map">SPLIT</span>
        <span class="match-score">13-10</span>
        <span class="match-result">W</span>
        <span class="match-comment">"Good Chill Night MVP'd. Announced it immediately."</span>
      </div>
      <div class="match-entry loss">
        <span class="match-map">BREEZE</span>
        <span class="match-score">6-13</span>
        <span class="match-result">L</span>
        <span class="match-comment">"Neilatron never left spawn. Literally."</span>
      </div>
      <div class="match-entry loss">
        <span class="match-map">SUNSET</span>
        <span class="match-score">4-13</span>
        <span class="match-result">L</span>
        <span class="match-comment">"Gaming chair expired at round 8. It was 10:47pm."</span>
      </div>
    </div>
  </section>

  <!-- TIER LIST -->
  <section class="tier-list" id="tierlist">
    <div class="section-header">
      <span class="section-tag">// TIER LIST</span>
      <h2>THE HONEST TIER LIST</h2>
    </div>
    <div class="tier-categories">
      <div class="tier-category">
        <h3 class="tier-cat-name">AIM</h3>
        <div class="tier-bars">
          <div class="tier-bar-row"><span class="tier-player">DOODLLEUS</span><div class="tier-bar-track"><div class="tier-bar-fill" style="--bar-color: #c742f5; --bar-width: 70%"></div></div><span class="tier-val">7</span></div>
          <div class="tier-bar-row"><span class="tier-player">TJC</span><div class="tier-bar-track"><div class="tier-bar-fill" style="--bar-color: #17ecc2; --bar-width: 50%"></div></div><span class="tier-val">5</span></div>
          <div class="tier-bar-row"><span class="tier-player">PRETTY MOUTH BOY</span><div class="tier-bar-track"><div class="tier-bar-fill" style="--bar-color: #f5a623; --bar-width: 30%"></div></div><span class="tier-val">3</span></div>
          <div class="tier-bar-row"><span class="tier-player">GOOD CHILL NIGHT</span><div class="tier-bar-track"><div class="tier-bar-fill" style="--bar-color: #f5d623; --bar-width: 40%"></div></div><span class="tier-val">4</span></div>
          <div class="tier-bar-row"><span class="tier-player">NEILATRON</span><div class="tier-bar-track"><div class="tier-bar-fill" style="--bar-color: #7aff4a; --bar-width: 50%"></div></div><span class="tier-val">5</span></div>
        </div>
      </div>
      <div class="tier-category">
