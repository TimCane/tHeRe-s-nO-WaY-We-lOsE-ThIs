<style>
  /* ===== GLITCH EFFECT ===== */
  .glitch {
    position: relative;
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 6px;
    color: var(--val-cream);
    text-shadow: 0 0 80px rgba(255,70,85,0.4), 0 0 150px rgba(255,70,85,0.1);
    animation: glitchText 8s infinite;
  }

  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    clip-path: inset(0);
  }

  .glitch::before {
    color: #ff4655;
    animation: glitch1 3s infinite linear alternate-reverse;
    text-shadow: 2px 0 #17ecc2;
  }

  .glitch::after {
    color: #17ecc2;
    animation: glitch2 2s infinite linear alternate-reverse;
    text-shadow: -2px 0 #ff4655;
  }

  @keyframes glitch1 {
    0%, 90%, 100% { clip-path: inset(0 0 100% 0); }
    92% { clip-path: inset(20% 0 40% 0); transform: translate(-4px, -2px); }
    94% { clip-path: inset(60% 0 10% 0); transform: translate(4px, 2px); }
    96% { clip-path: inset(40% 0 30% 0); transform: translate(-2px, 1px); }
    98% { clip-path: inset(80% 0 5% 0); transform: translate(2px, -1px); }
  }

  @keyframes glitch2 {
    0%, 88%, 100% { clip-path: inset(100% 0 0 0); }
    90% { clip-path: inset(30% 0 50% 0); transform: translate(3px, 1px); }
    93% { clip-path: inset(10% 0 70% 0); transform: translate(-3px, -1px); }
    95% { clip-path: inset(70% 0 15% 0); transform: translate(2px, 2px); }
    97% { clip-path: inset(5% 0 85% 0); transform: translate(-1px, -2px); }
  }

  @keyframes glitchText {
    0%, 95%, 100% { opacity: 1; }
    96% { opacity: 0.8; letter-spacing: 18px; }
    97% { opacity: 1; letter-spacing: 15px; }
  }

  /* ===== SCANLINES & NOISE ===== */
  .scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.08) 2px,
      rgba(0,0,0,0.08) 4px
    );
    z-index: 1;
    pointer-events: none;
    animation: scanMove 10s linear infinite;
  }

  @keyframes scanMove {
    0% { transform: translateY(0); }
    100% { transform: translateY(4px); }
  }

  .hero-noise {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px;
  }

  /* ===== HERO TAG DOTS ===== */
  .tag-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--val-red);
    border-radius: 50%;
    margin: 0 0.75rem;
    vertical-align: middle;
    animation: dotPulse 2s ease-in-out infinite;
    box-shadow: 0 0 10px var(--val-red), 0 0 20px var(--val-red);
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 10px var(--val-red), 0 0 20px var(--val-red); }
    50% { opacity: 0.4; box-shadow: 0 0 5px var(--val-red); }
  }

  /* ===== HERO ===== */
  .hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    animation: heroZoom 20s ease-in-out infinite alternate;
    filter: saturate(1.2) contrast(1.1);
  }

  @keyframes heroZoom {
    from { transform: scale(1.05); }
    to { transform: scale(1.15); }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 50%, rgba(255,70,85,0.15) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 50%, rgba(23,236,194,0.08) 0%, transparent 50%),
      linear-gradient(180deg, rgba(10,16,24,0.3) 0%, rgba(10,16,24,0.7) 50%, rgba(10,16,24,1) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero-tag {
    font-size: 0.8rem;
    letter-spacing: 6px;
    opacity: 0.6;
    margin-bottom: 1.5rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-sub {
    font-size: 1.2rem;
    letter-spacing: 6px;
    opacity: 0.7;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--val-red);
    text-shadow: 0 0 30px rgba(255,70,85,0.3);
    animation: subtitleFlicker 4s ease-in-out infinite;
  }

  @keyframes subtitleFlicker {
    0%, 92%, 100% { opacity: 0.7; }
    93% { opacity: 0.3; }
    94% { opacity: 0.8; }
    95% { opacity: 0.2; }
    96% { opacity: 0.7; }
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 3rem;
    padding: 1.5rem 3rem;
    background: rgba(255,70,85,0.05);
    border: 1px solid rgba(255,70,85,0.15);
    clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px), 0 12px);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--val-red);
    text-shadow: 0 0 20px rgba(255,70,85,0.4);
  }

  .stat-label {
    font-size: 0.6rem;
    letter-spacing: 3px;
    opacity: 0.4;
    margin-top: 0.25rem;
    font-weight: 600;
  }

  .hero-stat-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent, rgba(255,70,85,0.4), transparent);
  }

  .hero-cta {
    display: inline-block;
    margin-top: 3rem;
    padding: 1.2rem 3.5rem;
    background: var(--val-red);
    color: white;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 4px;
    transition: all 0.3s;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 30px rgba(255,70,85,0.3), inset 0 0 30px rgba(255,70,85,0.1);
  }

  .hero-cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    animation: ctaSweep 3s ease-in-out infinite;
  }

  @keyframes ctaSweep {
    0%, 60%, 100% { left: -100%; }
    30% { left: 100%; }
  }

  .hero-cta:hover {
    background: white;
    color: var(--val-dark);
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 15px 50px rgba(255,70,85,0.4), 0 0 80px rgba(255,70,85,0.2);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  .scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(180deg, transparent, var(--val-red));
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; height: 30px; }
    50% { opacity: 1; height: 50px; }
  }

  .scroll-indicator span {
    font-size: 0.6rem;
    letter-spacing: 4px;
    opacity: 0.4;
  }

  /* ===== ABOUT ===== */
  .about {
    padding: 8rem 3rem;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .section-header {
    margin-bottom: 4rem;
    position: relative;
  }

  .section-tag {
    font-size: 0.7rem;
    letter-spacing: 4px;
    color: var(--val-red);
    font-weight: 600;
    text-shadow: 0 0 10px rgba(255,70,85,0.3);
  }

  .section-header h2 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: 6px;
    margin-top: 0.5rem;
    line-height: 1;
    background: linear-gradient(135deg, var(--val-cream) 0%, rgba(236,232,225,0.6) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-lead {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 1.5rem;
    color: var(--val-cream);
  }

  .about-text p {
    font-size: 1rem;
    line-height: 1.8;
    opacity: 0.7;
  }

  .about-values {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .value {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 3px;
    padding: 0.75rem 1rem;
    background: rgba(255,70,85,0.03);
    border-left: 2px solid var(--val-red);
    transition: all 0.3s;
  }

  .value:hover {
    background: rgba(255,70,85,0.08);
    transform: translateX(4px);
    box-shadow: 0 0 20px rgba(255,70,85,0.1);
  }

  .value-icon {
    color: var(--val-red);
    font-size: 0.6rem;
    text-shadow: 0 0 8px var(--val-red);
  }

  .about-image {
    position: relative;
  }

  .about-image img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
    transition: all 0.5s;
    filter: saturate(1.1);
  }

  .about-image:hover img {
    filter: saturate(1.3) brightness(1.1);
    box-shadow: 0 0 60px rgba(255,70,85,0.2);
  }

  .about-image-accent {
    position: absolute;
    top: -10px;
    right: -10px;
    bottom: 10px;
    left: 10px;
    border: 1px solid var(--val-red);
    opacity: 0.3;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
    z-index: -1;
    animation: accentPulse 3s ease-in-out infinite;
  }

  @keyframes accentPulse {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.5; }
  }

  /* ===== ROSTER ===== */
  .roster {
    padding: 4rem 3rem 8rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .player-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .player-card {
    position: relative;
    background: rgba(236,232,225,0.03);
    border: 1px solid rgba(236,232,225,0.06);
    overflow: hidden;
    text-decoration: none;
    color: var(--val-cream);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }

  .player-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, var(--accent));
    opacity: 0;
    transition: opacity 0.4s;
    z-index: 1;
    mix-blend-mode: overlay;
  }

  .player-card:hover::before {
    opacity: 0.3;
  }

  .player-card:hover {
    transform: translateY(-10px) scale(1.02);
    border-color: var(--accent);
    box-shadow:
      0 25px 70px rgba(0,0,0,0.5),
      0 0 50px color-mix(in srgb, var(--accent) 20%, transparent),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }

  .card-image {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s;
    filter: saturate(0.9);
  }

  .player-card:hover .card-image img {
    transform: scale(1.15);
    filter: saturate(1.2) brightness(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 20%, var(--val-darker) 100%);
  }

  .card-rank {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(10,16,24,0.85);
    padding: 0.4rem 0.8rem;
    font-size: 0.6rem;
    letter-spacing: 2px;
    font-weight: 700;
    border: 1px solid rgba(236,232,225,0.15);
    z-index: 2;
    backdrop-filter: blur(8px);
  }

  .card-content {
    padding: 1.2rem 1.5rem 1.5rem;
    flex: 1;
    position: relative;
    z-index: 2;
  }

  .card-role {
    font-size: 0.65rem;
    letter-spacing: 3px;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.4rem;
    text-shadow: 0 0 15px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .card-name {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 3px;
    line-height: 1;
  }

  .card-tag {
    font-size: 0.7rem;
    opacity: 0.4;
    letter-spacing: 2px;
    margin-top: 0.3rem;
    text-transform: uppercase;
  }

  .card-stats {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.65rem;
    letter-spacing: 1px;
    opacity: 0.5;
    font-weight: 600;
  }

  .card-arrow {
    position: absolute;
    bottom: 1.2rem;
    right: 1.5rem;
    font-size: 1.5rem;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s;
    color: var(--accent);
    text-shadow: 0 0 15px var(--accent);
    z-index: 2;
  }

  .player-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ===== AGENT ABILITY ANIMATIONS ===== */
  .ability-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .player-card:hover .ability-fx {
    opacity: 1;
  }

  /* Doodlleus - Reyna: purple soul orbs floating up */
  .ability-doodlleus:hover .ability-fx {
    background:
      radial-gradient(circle at 20% 80%, rgba(199,66,245,0.4) 0%, transparent 30%),
      radial-gradient(circle at 80% 60%, rgba(199,66,245,0.3) 0%, transparent 25%),
      radial-gradient(circle at 50% 90%, rgba(199,66,245,0.2) 0%, transparent 35%);
    animation: reynaSouls 2s ease-in-out infinite;
  }

  @keyframes reynaSouls {
    0%, 100% { background-position: 0% 100%, 100% 80%, 50% 100%; }
    50% { background-position: 0% 60%, 100% 40%, 50% 50%; }
  }

  /* TJC - Sage: teal healing wave rising from bottom */
  .ability-tjc:hover .ability-fx {
    background: linear-gradient(0deg, rgba(23,236,194,0.3) 0%, rgba(23,236,194,0.1) 30%, transparent 60%);
    animation: sageHeal 1.5s ease-in-out infinite;
  }

  @keyframes sageHeal {
    0%, 100% { opacity: 0.6; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-10px); }
  }

  /* Pretty Mouth Boy - Brimstone: orange smoke clouds */
  .ability-prettymouthboy:hover .ability-fx {
    background:
      radial-gradient(ellipse at 30% 70%, rgba(245,166,35,0.35) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(245,166,35,0.25) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 85%, rgba(245,166,35,0.3) 0%, transparent 40%);
    animation: brimSmoke 3s ease-in-out infinite;
  }

  @keyframes brimSmoke {
    0%, 100% { filter: blur(8px); opacity: 0.7; }
    50% { filter: blur(15px); opacity: 1; }
  }

  /* Chill Good Night - Killjoy: yellow electric sparks */
  .ability-chillgoodnight:hover .ability-fx {
    background:
      radial-gradient(circle at 25% 75%, rgba(245,214,35,0.4) 0%, transparent 15%),
      radial-gradient(circle at 75% 25%, rgba(245,214,35,0.3) 0%, transparent 15%),
      radial-gradient(circle at 50% 50%, rgba(245,214,35,0.2) 0%, transparent 20%);
    animation: kjSpark 0.8s steps(3) infinite;
  }

  @keyframes kjSpark {
    0% { background-position: 0 0, 100% 0, 50% 50%; }
    33% { background-position: 10% 10%, 90% 20%, 40% 60%; }
    66% { background-position: 5% 15%, 85% 10%, 55% 45%; }
    100% { background-position: 0 0, 100% 0, 50% 50%; }
  }

  /* Neilatron - Gekko: green slime drip */
  .ability-neilatron:hover .ability-fx {
    background: linear-gradient(180deg, rgba(122,255,74,0.3) 0%, rgba(122,255,74,0.15) 40%, transparent 70%);
    animation: gekkoSlime 2s ease-in-out infinite;
  }

  @keyframes gekkoSlime {
    0%, 100% { clip-path: polygon(0 0, 100% 0, 100% 30%, 80% 35%, 60% 28%, 40% 38%, 20% 32%, 0 36%); }
    50% { clip-path: polygon(0 0, 100% 0, 100% 45%, 80% 50%, 60% 42%, 40% 52%, 20% 46%, 0 50%); }
  }

  /* ===== GALLERY ===== */
  .gallery {
    padding: 4rem 3rem;
    overflow: hidden;
    position: relative;
  }

  .gallery::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--val-red), transparent);
    opacity: 0.3;
  }

  .gallery .section-header {
    max-width: 1200px;
    margin: 0 auto 4rem;
  }

  .gallery-scroll {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 5%, black 95%, transparent);
  }

  .gallery-track {
    display: flex;
    gap: 1.5rem;
    animation: gallerySlide 25s linear infinite;
    width: max-content;
  }

  .gallery-track img {
    height: 320px;
    width: auto;
    object-fit: cover;
    opacity: 0.6;
    transition: all 0.4s;
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
    filter: saturate(0.8);
  }

  .gallery-track img:hover {
    opacity: 1;
    filter: saturate(1.3) brightness(1.1);
    transform: scale(1.05);
    box-shadow: 0 0 40px rgba(255,70,85,0.2);
  }

  @keyframes gallerySlide {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ===== CTA ===== */
  .cta {
    position: relative;
    height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: 4rem;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
  }

  .cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
    filter: saturate(1.3);
    animation: heroZoom 25s ease-in-out infinite alternate;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(255,70,85,0.08) 0%, transparent 60%),
      linear-gradient(180deg, var(--val-darker) 0%, rgba(10,16,24,0.5) 50%, var(--val-darker) 100%);
  }

  .cta-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .cta-content h2 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: 8px;
    text-shadow: 0 0 60px rgba(255,70,85,0.3);
  }

  .cta-content p {
    margin-top: 1.5rem;
    opacity: 0.5;
    font-size: 1.1rem;
    letter-spacing: 3px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ===== QUOTE TICKER ===== */
  .ticker {
    overflow: hidden;
    padding: 1.2rem 0;
    border-top: 1px solid rgba(255,70,85,0.15);
    border-bottom: 1px solid rgba(255,70,85,0.15);
    background: rgba(255,70,85,0.03);
  }

  .ticker-track {
    display: flex;
    gap: 2rem;
    animation: tickerScroll 40s linear infinite;
    width: max-content;
    white-space: nowrap;
  }

  .ticker-track span {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--val-cream);
    opacity: 0.6;
  }

  .ticker-track span:nth-child(even) {
    color: var(--val-red);
    font-size: 0.5rem;
    opacity: 0.3;
    vertical-align: middle;
  }

  @keyframes tickerScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ===== STATS COMPARISON ===== */
  .comparison {
    padding: 6rem 3rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .comparison-sub {
    font-size: 0.8rem;
    letter-spacing: 3px;
    opacity: 0.3;
    margin-top: -3rem;
    margin-bottom: 3rem;
  }

  .compare-table {
    width: 100%;
  }

  .compare-header {
    display: grid;
    grid-template-columns: 180px repeat(4, 1fr);
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255,70,85,0.2);
    margin-bottom: 0.5rem;
  }

  .compare-header .compare-cell {
    font-size: 0.6rem;
    letter-spacing: 3px;
    font-weight: 700;
    color: var(--val-red);
    opacity: 0.7;
  }

  .compare-row {
    display: grid;
    grid-template-columns: 180px repeat(4, 1fr);
    gap: 1rem;
    padding: 1rem;
    border-bottom: 1px solid rgba(236,232,225,0.04);
    transition: all 0.3s;
    align-items: center;
  }

  .compare-row:hover {
    background: rgba(236,232,225,0.03);
