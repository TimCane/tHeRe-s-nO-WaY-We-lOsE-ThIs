<script>
  // === EXCUSE GENERATOR ===
  const excuses = [
    "Pretty Mouth Boy was in Factorio",
    "Doodlleus's gaming chair expired at 11pm",
    "Neilatron was still in spawn",
    "TJC bait rez'd everyone",
    "Good Chill Night was site adjacent",
    "Nobody bought util",
    "We all bought Odins and they had an Op",
    "TJC fell asleep",
    "The Wasteland Vandal energy was off",
    "Good Chill Night said 'Mayb' and we took that as a yes",
    "We tried lineups for the first time",
    "Pretty Mouth Boy's pipe burst again",
    "Neilatron said 'Aye' but meant 'nay'",
    "Someone called a stinger rush mid on round 12",
    "The vibes were off",
    "TJC said 'This is why im the viper' and then whiffed",
    "Good Chill Night's turret got more kills than the team combined",
    "We were winning until we started losing",
    "Doodlleus blue screened",
    "Pretty Mouth Boy said 'purchance' and we didn't know if that meant he was playing",
    "Doodlleus said 'Fuck you Good Chill Night' and she took it personally",
    "Good Chill Night existed and Doodlleus couldn't cope"
  ];

  const excuseText = document.getElementById('excuse-text');
  const excuseBtn = document.getElementById('excuse-btn');

  if (excuseBtn && excuseText) {
    excuseBtn.addEventListener('click', () => {
      const excuse = excuses[Math.floor(Math.random() * excuses.length)];
      excuseText.style.opacity = '0';
      excuseText.style.transform = 'skewX(-5deg)';
      setTimeout(() => {
        excuseText.textContent = excuse;
        excuseText.style.opacity = '1';
        excuseText.style.transform = 'skewX(0deg)';
      }, 200);
    });
  }

  // === COUNT-UP ANIMATION ===
  const countUpEls = document.querySelectorAll('.count-up');
  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.target || '0', 10);
        const suffix = el.dataset.suffix || '';
        if (target === 0) {
          el.textContent = '0' + suffix;
          countObserver.unobserve(el);
          return;
        }
        const duration = 1500;
        const startTime = performance.now();
        const animate = (now: number) => {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(eased * target);
          el.textContent = current + suffix;
          if (progress < 1) {
            requestAnimationFrame(animate);
          } else {
            el.textContent = target + suffix;
          }
        };
        requestAnimationFrame(animate);
        countObserver.unobserve(el);
      }
    });
  }, { threshold: 0.3 });

  countUpEls.forEach(el => countObserver.observe(el));

  // === 3D TILT EFFECT ON PLAYER CARDS ===
  document.querySelectorAll('.player-card').forEach(card => {
    const el = card as HTMLElement;
    el.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateY = ((x - centerX) / centerX) * 12;
      const rotateX = ((centerY - y) / centerY) * 12;
      el.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-10px) scale(1.02)`;
    });
    el.addEventListener('mouseleave', () => {
      el.style.transition = 'transform 0.5s ease-out';
      el.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateY(0) scale(1)';
      setTimeout(() => {
        el.style.transition = '';
      }, 500);
    });
  });
</script>
