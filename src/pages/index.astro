  .value {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 3px;
    padding: 0.75rem 1rem;
    background: rgba(255,70,85,0.03);
    border-left: 2px solid var(--val-red);
    transition: all 0.3s;
  }

  .value:hover {
    background: rgba(255,70,85,0.08);
    transform: translateX(4px);
    box-shadow: 0 0 20px rgba(255,70,85,0.1);
  }

  .value-icon {
    color: var(--val-red);
    font-size: 0.6rem;
    text-shadow: 0 0 8px var(--val-red);
  }

  .about-image {
    position: relative;
  }

  .about-image img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
    transition: all 0.5s;
    filter: saturate(1.1);
  }

  .about-image:hover img {
    filter: saturate(1.3) brightness(1.1);
    box-shadow: 0 0 60px rgba(255,70,85,0.2);
  }

  .about-image-accent {
    position: absolute;
    top: -10px;
    right: -10px;
    bottom: 10px;
    left: 10px;
    border: 1px solid var(--val-red);
    opacity: 0.3;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
    z-index: -1;
    animation: accentPulse 3s ease-in-out infinite;
  }

  @keyframes accentPulse {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.5; }
  }

  /* ===== ROSTER ===== */
  .roster {
    padding: 4rem 3rem 8rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .player-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .player-card {
    position: relative;
    background: rgba(236,232,225,0.03);
    border: 1px solid rgba(236,232,225,0.06);
    overflow: hidden;
    text-decoration: none;
    color: var(--val-cream);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }

  .player-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, var(--accent));
    opacity: 0;
    transition: opacity 0.4s;
    z-index: 1;
    mix-blend-mode: overlay;
  }

  .player-card:hover::before {
    opacity: 0.3;
  }

  .player-card:hover {
    transform: translateY(-10px) scale(1.02);
    border-color: var(--accent);
    box-shadow:
      0 25px 70px rgba(0,0,0,0.5),
      0 0 50px color-mix(in srgb, var(--accent) 20%, transparent),
      inset 0 1px 0 rgba(255,255,255,0.05);
  }

  .card-image {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s;
    filter: saturate(0.9);
  }

  .player-card:hover .card-image img {
    transform: scale(1.15);
    filter: saturate(1.2) brightness(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 20%, var(--val-darker) 100%);
  }

  .card-rank {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(10,16,24,0.85);
    padding: 0.4rem 0.8rem;
    font-size: 0.6rem;
    letter-spacing: 2px;
    font-weight: 700;
    border: 1px solid rgba(236,232,225,0.15);
    z-index: 2;
    backdrop-filter: blur(8px);
  }

  .card-content {
    padding: 1.2rem 1.5rem 1.5rem;
    flex: 1;
    position: relative;
    z-index: 2;
  }

  .card-role {
    font-size: 0.65rem;
    letter-spacing: 3px;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.4rem;
    text-shadow: 0 0 15px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .card-name {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 3px;
    line-height: 1;
  }

  .card-tag {
    font-size: 0.7rem;
    opacity: 0.4;
    letter-spacing: 2px;
    margin-top: 0.3rem;
    text-transform: uppercase;
  }

  .card-stats {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.65rem;
    letter-spacing: 1px;
    opacity: 0.5;
    font-weight: 600;
  }

  .card-arrow {
    position: absolute;
    bottom: 1.2rem;
    right: 1.5rem;
    font-size: 1.5rem;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s;
    color: var(--accent);
    text-shadow: 0 0 15px var(--accent);
    z-index: 2;
  }

  .player-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ===== AGENT ABILITY ANIMATIONS ===== */
  .ability-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .player-card:hover .ability-fx {
    opacity: 1;
  }

  /* Doodlleus - Reyna: purple soul orbs floating up */
  .ability-doodlleus:hover .ability-fx {
    background:
      radial-gradient(circle at 20% 80%, rgba(199,66,245,0.4) 0%, transparent 30%),
      radial-gradient(circle at 80% 60%, rgba(199,66,245,0.3) 0%, transparent 25%),
      radial-gradient(circle at 50% 90%, rgba(199,66,245,0.2) 0%, transparent 35%);
    animation: reynaSouls 2s ease-in-out infinite;
  }

  @keyframes reynaSouls {
    0%, 100% { background-position: 0% 100%, 100% 80%, 50% 100%; }
    50% { background-position: 0% 60%, 100% 40%, 50% 50%; }
  }

  /* TJC - Sage: teal healing wave rising from bottom */
  .ability-tjc:hover .ability-fx {
    background: linear-gradient(0deg, rgba(23,236,194,0.3) 0%, rgba(23,236,194,0.1) 30%, transparent 60%);
    animation: sageHeal 1.5s ease-in-out infinite;
  }

  @keyframes sageHeal {
    0%, 100% { opacity: 0.6; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-10px); }
  }

  /* Pretty Mouth Boy - Brimstone: orange smoke clouds */
  .ability-prettymouthboy:hover .ability-fx {
    background:
      radial-gradient(ellipse at 30% 70%, rgba(245,166,35,0.35) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(245,166,35,0.25) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 85%, rgba(245,166,35,0.3) 0%, transparent 40%);
    animation: brimSmoke 3s ease-in-out infinite;
  }

  @keyframes brimSmoke {
    0%, 100% { filter: blur(8px); opacity: 0.7; }
    50% { filter: blur(15px); opacity: 1; }
  }

  /* Good Chill Night - Killjoy: yellow electric sparks */
  .ability-goodchillnight:hover .ability-fx {
    background:
      radial-gradient(circle at 25% 75%, rgba(245,214,35,0.4) 0%, transparent 15%),
      radial-gradient(circle at 75% 25%, rgba(245,214,35,0.3) 0%, transparent 15%),
      radial-gradient(circle at 50% 50%, rgba(245,214,35,0.2) 0%, transparent 20%);
    animation: kjSpark 0.8s steps(3) infinite;
  }

  @keyframes kjSpark {
    0% { background-position: 0 0, 100% 0, 50% 50%; }
    33% { background-position: 10% 10%, 90% 20%, 40% 60%; }
    66% { background-position: 5% 15%, 85% 10%, 55% 45%; }
    100% { background-position: 0 0, 100% 0, 50% 50%; }
  }

  /* Neilatron - Gekko: green slime drip */
  .ability-neilatron:hover .ability-fx {
    background: linear-gradient(180deg, rgba(122,255,74,0.3) 0%, rgba(122,255,74,0.15) 40%, transparent 70%);
    animation: gekkoSlime 2s ease-in-out infinite;
  }

  @keyframes gekkoSlime {
    0%, 100% { clip-path: polygon(0 0, 100% 0, 100% 30%, 80% 35%, 60% 28%, 40% 38%, 20% 32%, 0 36%); }
    50% { clip-path: polygon(0 0, 100% 0, 100% 45%, 80% 50%, 60% 42%, 40% 52%, 20% 46%, 0 50%); }
  }

  /* ===== GALLERY ===== */
  .gallery {
    padding: 4rem 3rem;
    overflow: hidden;
    position: relative;
  }

  .gallery::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--val-red), transparent);
    opacity: 0.3;
  }

  .gallery .section-header {
    max-width: 1200px;
    margin: 0 auto 4rem;
  }

  .gallery-scroll {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 5%, black 95%, transparent);
  }

  .gallery-track {
    display: flex;
    gap: 1.5rem;
    animation: gallerySlide 25s linear infinite;
    width: max-content;
  }

  .gallery-track img {
    height: 320px;
    width: auto;
    object-fit: cover;
    opacity: 0.6;
    transition: all 0.4s;
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
    filter: saturate(0.8);
  }

  .gallery-track img:hover {
    opacity: 1;
    filter: saturate(1.3) brightness(1.1);
    transform: scale(1.05);
    box-shadow: 0 0 40px rgba(255,70,85,0.2);
  }

  @keyframes gallerySlide {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ===== CTA ===== */
  .cta {
    position: relative;
    height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: 4rem;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
  }

  .cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
    filter: saturate(1.3);
    animation: heroZoom 25s ease-in-out infinite alternate;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(255,70,85,0.08) 0%, transparent 60%),
      linear-gradient(180deg, var(--val-darker) 0%, rgba(10,16,24,0.5) 50%, var(--val-darker) 100%);
  }

  .cta-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .cta-content h2 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: 8px;
    text-shadow: 0 0 60px rgba(255,70,85,0.3);
  }

  .cta-content p {
    margin-top: 1.5rem;
    opacity: 0.5;
    font-size: 1.1rem;
    letter-spacing: 3px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ===== QUOTE TICKER ===== */
  .ticker {
    overflow: hidden;
    padding: 1.2rem 0;
    border-top: 1px solid rgba(255,70,85,0.15);
    border-bottom: 1px solid rgba(255,70,85,0.15);
    background: rgba(255,70,85,0.03);
  }

  .ticker-track {
    display: flex;
    gap: 2rem;
    animation: tickerScroll 40s linear infinite;
    width: max-content;
    white-space: nowrap;
  }

  .ticker-track span {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--val-cream);
    opacity: 0.6;
  }

  .ticker-track span:nth-child(even) {
    color: var(--val-red);
    font-size: 0.5rem;
    opacity: 0.3;
    vertical-align: middle;
  }

  @keyframes tickerScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ===== FLOWCHART ===== */
  .flowchart {
    padding: 6rem 3rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .flow-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .flow-card {
    background: rgba(236,232,225,0.02);
    border: 1px solid rgba(236,232,225,0.06);
    padding: 1.5rem;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
    transition: all 0.3s;
  }

  .flow-card:hover {
    border-color: var(--accent);
    background: rgba(236,232,225,0.04);
    box-shadow: 0 0 30px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .flow-card h3 {
    font-size: 0.85rem;
    letter-spacing: 4px;
    color: var(--accent);
    margin-bottom: 1.2rem;
    font-weight: 700;
  }

  .flow-steps {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .flow-step {
    font-size: 0.75rem;
    letter-spacing: 1px;
    text-align: center;
    padding: 0.5rem 0.75rem;
    background: rgba(236,232,225,0.03);
    border: 1px solid rgba(236,232,225,0.06);
    width: 100%;
    opacity: 0.7;
  }

  .flow-arrow {
    color: var(--accent);
    font-size: 0.8rem;
    opacity: 0.4;
  }

  .flow-step.result {
    font-weight: 700;
    letter-spacing: 3px;
    border-color: var(--accent);
    color: var(--accent);
    opacity: 1;
    font-size: 0.8rem;
  }

  .flow-note {
    font-size: 0.6rem;
    opacity: 0.3;
    margin-top: 0.5rem;
    letter-spacing: 1px;
    text-align: center;
    font-style: italic;
  }

  /* ===== STATS COMPARISON ===== */
  .comparison {
    padding: 6rem 3rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .comparison-sub {
    font-size: 0.8rem;
    letter-spacing: 3px;
    opacity: 0.3;
    margin-top: -3rem;
    margin-bottom: 3rem;
  }

  .compare-table {
    width: 100%;
  }

  .compare-header {
    display: grid;
    grid-template-columns: 180px repeat(4, 1fr);
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255,70,85,0.2);
    margin-bottom: 0.5rem;
  }

  .compare-header .compare-cell {
    font-size: 0.6rem;
    letter-spacing: 3px;
    font-weight: 700;
    color: var(--val-red);
    opacity: 0.7;
  }

  .compare-row {
    display: grid;
    grid-template-columns: 180px repeat(4, 1fr);
    gap: 1rem;
    padding: 1rem;
    border-bottom: 1px solid rgba(236,232,225,0.04);
    transition: all 0.3s;
    align-items: center;
  }

  .compare-row:hover {
    background: rgba(236,232,225,0.03);
    border-color: var(--accent);
  }

  .compare-cell {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .compare-cell.label {
    font-size: 0.75rem;
    letter-spacing: 3px;
    color: var(--accent);
    font-weight: 700;
  }

  .bar-wrap {
    width: 60px;
    height: 4px;
    background: rgba(236,232,225,0.08);
    border-radius: 2px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .bar {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    transition: width 1s ease;
  }

  .rank-cell {
    font-size: 0.7rem;
    letter-spacing: 2px;
    opacity: 0.5;
  }

  /* ===== ODIN WALL ===== */
  .odin-wall {
    padding: 6rem 3rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .odin-sub {
    font-size: 0.9rem;
    opacity: 0.5;
    margin-top: -3rem;
    margin-bottom: 3rem;
    letter-spacing: 2px;
  }

  .odin-grid {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: 'Courier New', monospace;
    background: rgba(10,16,24,0.6);
    border: 1px solid rgba(236,232,225,0.08);
    padding: 1.5rem;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
  }

  .odin-msg {
    font-size: 0.78rem;
    line-height: 1.6;
    letter-spacing: 0.5px;
  }

  .odin-msg.enemy {
    color: #ff6b6b;
    opacity: 0.7;
  }

  .odin-msg.team {
    color: #6bffb8;
    opacity: 0.9;
  }

  .msg-tag {
    font-weight: 700;
  }

  /* ===== ACE WATCH ===== */
  .ace-watch {
    padding: 6rem 3rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(245,214,35,0.1);
    border-bottom: 1px solid rgba(245,214,35,0.1);
    background: radial-gradient(ellipse at center, rgba(245,214,35,0.03) 0%, transparent 60%);
  }

  .ace-content {
    position: relative;
    z-index: 2;
  }

  .ace-watch h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 6px;
    margin-top: 0.5rem;
  }

  .ace-subtitle {
    font-size: 0.8rem;
    letter-spacing: 5px;
    opacity: 0.4;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  .ace-counter {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    margin: 3rem 0;
    padding: 2rem;
    background: rgba(245,214,35,0.03);
    border: 1px solid rgba(245,214,35,0.1);
    display: inline-flex;
    clip-path: polygon(16px 0, calc(100% - 16px) 0, 100% 16px, 100% calc(100% - 16px), calc(100% - 16px) 100%, 16px 100%, 0 calc(100% - 16px), 0 16px);
  }

  .ace-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ace-num {
    font-size: 3.5rem;
    font-weight: 700;
    color: #f5d623;
    text-shadow: 0 0 30px rgba(245,214,35,0.3);
    line-height: 1;
  }

  .ace-label {
    font-size: 0.55rem;
    letter-spacing: 3px;
    opacity: 0.4;
    margin-top: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .ace-divider {
    width: 1px;
    height: 50px;
    background: linear-gradient(180deg, transparent, rgba(245,214,35,0.3), transparent);
  }

  .ace-quote {
    font-size: 1.3rem;
    font-style: italic;
    opacity: 0.5;
    margin-top: 2rem;
  }

  .ace-attribution {
    font-size: 0.7rem;
    letter-spacing: 3px;
    opacity: 0.25;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  /* ===== GUN GAME ===== */
  .gun-game {
    padding: 6rem 3rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .gun-game-sub {
    font-size: 0.9rem;
    opacity: 0.5;
    margin-top: -3rem;
    margin-bottom: 3rem;
    letter-spacing: 1px;
    line-height: 1.6;
  }

  .gun-ladder {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .gun-step {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.9rem 1.2rem;
    background: rgba(236,232,225,0.02);
    border: 1px solid rgba(236,232,225,0.05);
    border-left: 3px solid rgba(255,70,85,0.3);
    transition: all 0.3s;
  }

  .gun-step:hover {
    background: rgba(255,70,85,0.05);
    border-left-color: var(--val-red);
    transform: translateX(4px);
  }

  .gun-step.final {
    border-left-color: var(--val-red);
    background: rgba(255,70,85,0.06);
  }

  .gun-step.final .gun-name {
    color: var(--val-red);
    text-shadow: 0 0 20px rgba(255,70,85,0.3);
  }

  .gun-num {
    font-size: 0.6rem;
    letter-spacing: 2px;
    opacity: 0.3;
    font-weight: 700;
    min-width: 1.5rem;
  }

  .gun-name {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 4px;
    min-width: 140px;
  }

  .gun-note {
    font-size: 0.7rem;
    opacity: 0.35;
    letter-spacing: 1px;
    font-style: italic;
  }

  .gun-connector {
    width: 3px;
    height: 8px;
    background: rgba(255,70,85,0.15);
    margin-left: 1.2rem;
  }

  .gun-rules {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .gun-rule {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    letter-spacing: 2px;
    font-weight: 600;
    padding: 0.6rem 1rem;
    background: rgba(255,70,85,0.03);
    border-left: 2px solid var(--val-red);
    opacity: 0.7;
  }

  .rule-icon {
    color: var(--val-red);
    font-size: 0.5rem;
  }

  .gun-legend {
    margin-top: 3rem;
  }

  .legend-card {
    background: rgba(255,70,85,0.04);
    border: 1px solid rgba(255,70,85,0.15);
    padding: 2rem;
    text-align: center;
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }

  .legend-title {
    font-size: 0.7rem;
    letter-spacing: 5px;
    color: var(--val-red);
