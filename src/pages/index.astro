import MatchHistory from '../components/MatchHistory.astro';
import ExcuseGenerator from '../components/ExcuseGenerator.astro';

const players = [
  {
    name: "DOODLLEUS",
    tag: "DOODLLEUS",
    role: "Duelist",
    agents: "Reyna / Neon",
    quote: "Sploink?",
    image: "/assets/E8a1_Cineposter_4x5_IG.jpg",
    accent: "#c742f5",
    slug: "doodlleus",
    stats: { kd: "0.96", hs: "19.3%", wr: "49.3%" }
  },
  {
    name: "TJC",
    tag: "TJC",
    role: "Support / Controller",
    agents: "Sage / Viper",
    quote: "Ah yep -- classic.",
    image: "/assets/FirstLook_SageHealConcept.jpg",
    accent: "#17ecc2",
    slug: "tjc",
    stats: { kd: "1.01", hs: "17.8%", wr: "51.2%" }
  },
  {
    name: "PRETTY MOUTH BOY",
    tag: "PRETTYMOUTHBOY",
    role: "Controller",
    agents: "Brimstone",
    quote: "Not a gamer anymore.",
    image: "/assets/FirstLook_ClassicRevolverConcept_VALORANT.jpg",
    accent: "#f5a623",
    slug: "prettymouthboy",
    stats: { kd: "0.90", hs: "13.5%", wr: "48.2%" }
  },
  {
    name: "CHILL GOOD NIGHT",
    tag: "CHILLGOODNIGHT",
    role: "Sentinel",
    agents: "Killjoy",
    quote: "Only 1.",
    image: "/assets/VALORANT_Deadlock_Wallpapers_4k_Dark2.jpg",
    accent: "#f5d623",
    slug: "chillgoodnight",
    stats: { kd: "???", hs: "???", wr: "???" }
