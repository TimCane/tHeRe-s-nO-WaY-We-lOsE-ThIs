---
import Layout from '../../layouts/Layout.astro';
import TrackerStats from '../../components/TrackerStats.astro';
import PlayerPageStyles from '../../components/PlayerPageStyles.astro';

const player = {
  name: "DOODLLEUS",
  role: "Duelist",
  agents: "Reyna / Neon",
  quote: "We don't simply 'play', Jack. We perform. We win. We dominate! And when we don't, we blame Chill Good Night.",
  image: "/assets/E8a1_Cineposter_4x5_IG.jpg",
  banner: "/assets/Ep8a1_Defiance_Riot Client Login Page 1440p.png",
  extra: "/assets/China_CG_Sagefire_Full.jpg",
  accent: "#c742f5",
  rank: "Gold 3",
  stats: { kd: "1.23", hs: "12.4%", wr: "51.5%", dmg: "163", adr: "163", matches: "1,088" },
  trackerAgents: [
    { name: "REYNA", matches: 1088, kd: "1.38", wr: "51.5%", acs: "207.3" },
    { name: "SAGE", matches: 105, kd: "1.32", wr: "50.5%", acs: "-" },
    { name: "VIPER", matches: 49, kd: "1.38", wr: "49.0%", acs: "-" },
    { name: "PHOENIX", matches: 91, kd: "1.22", wr: "52.7%", acs: "-" },
    { name: "JETT", matches: 80, kd: "1.21", wr: "52.5%", acs: "-" },
    { name: "KILLJOY", matches: 47, kd: "1.18", wr: "55.3%", acs: "-" },
  ],
  trackerWeapons: [
    { name: "VANDAL", kills: 11672, hs: "18.2%" },
    { name: "PHANTOM", kills: 4101, hs: "15.9%" },
    { name: "OPERATOR", kills: 3105, hs: "9.8%" },
  ],
  trackerMaps: [
    { name: "SPLIT", wr: "60%", record: "138W-73L", kd: "1.28" },
    { name: "HAVEN", wr: "54%", record: "158W-94L", kd: "1.24" },
    { name: "BIND", wr: "52%", record: "133W-127L", kd: "1.37" },
    { name: "SUNSET", wr: "54%", record: "43W-25L", kd: "1.22" },
    { name: "BREEZE", wr: "55%", record: "50W-35L", kd: "1.21" },
    { name: "ICEBOX", wr: "46%", record: "72W-81L", kd: "1.35" },
    { name: "ASCENT", wr: "46%", record: "124W-119L", kd: "1.25" },
    { name: "PEARL", wr: "36%", record: "29W-42L", kd: "1.18" },
  ],
  bio: "The heart and soul of tHeRe's nO WaY We lOsE ThIs. Every single game night begins the same way: Doodlleus dropping a cryptic one-word message in the group chat. 'Sploink?' 'Oingoboingo?' 'Chimchimcheroo?' 'Boom boom pow?' If Doodlleus doesn't ask, the squad doesn't play. The man has kids to Calpol and early mornings to survive, but he will ALWAYS find time to try and assemble the 5-stack. Valorant has shown us that this is, in his own words, 'a good gaming chair that loses its power after 11pm.' He once tried Chamber. We don't talk about that. He also once blue-screened mid-session and came back like nothing happened. A tinkerer by day — builds AI image boxes with buttons, does woodworking — and a Reyna main by night. Fuelled entirely by late-night coffee, the unshakeable belief that tonight is the night they hit Plat, and an inexhaustible supply of 'Fuck you Chill Good Night' for every conceivable situation. Good round? 'Fuck you Chill Good Night.' Bad round? 'Fuck you Chill Good Night.' Chill Good Night gets MVP? Believe it or not, 'Fuck you Chill Good Night.'",
  playstyle: "Reyna when the vibes say 'feast mode.' Neon when the vibes say 'I have thirty seconds of gaming chair power left.' A genuine menace in the first few games of the night. The gaming chair is scientifically proven to lose all power at 11pm sharp. Before that? Cracked aim, disgusting Reyna dismisses, Neon slides that make the enemy team type '???' in all chat. After that? A man desperately trying to stay awake while his K/D crumbles. Always happy though. Always. Even at 0-12. 'I'm always happy,' he says, through gritted teeth.",
  highlights: [
    "The 'Sploink?' heard round the world — rallied the squad from a 0-game night to a 5-game session",
    "Blue-screened mid-clutch, reconnected, and pretended nothing happened",
    "The Chamber experiment of 2023 — a dark chapter in squad history, never to be repeated",
    "Has said 'Fuck you Chill Good Night' more times than he's said 'games tonight?' — and that's saying something"
  ]
};
---

<Layout title={`${player.name} // tHeRe's nO WaY We lOsE ThIs`}>
  <!-- ENTRANCE ANIMATION -->
  <div class="entrance-overlay" id="entrance-overlay">
    <div class="entrance-content">
      <div class="entrance-agent">{player.agents}</div>
      <div class="entrance-name" style={`color: ${player.accent}`}>{player.name}</div>
      <div class="entrance-role">{player.role}</div>
    </div>
  </div>

  <section class="player-hero" style={`--accent: ${player.accent}`}>
    <div class="hero-bg parallax-bg" id="parallax-bg">
      <img src={player.banner} alt="" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <a href="/" class="back-link">&larr; BACK TO SQUAD</a>
      <div class="player-agents">{player.agents}</div>
      <h1 class="player-name">{player.name}</h1>
      <div class="player-role">{player.role}</div>
      <p class="player-quote">"{player.quote}"</p>
    </div>
  </section>

  <!-- ACHIEVEMENT BADGES -->
  <section class="badges-section" style={`--accent: ${player.accent}`}>
    <h2 class="badges-title">ACHIEVEMENTS</h2>
    <div class="badges-grid">
      <div class="badge" style="--badge-color: #c742f5">
        <span class="badge-icon">&#9733;</span>
        <span class="badge-name">SQUAD INITIATOR</span>
        <span class="badge-desc">Starts every game night</span>
      </div>
      <div class="badge" style="--badge-color: #ff4655">
        <span class="badge-icon">&#9889;</span>
        <span class="badge-name">FIRST BLOOD KING</span>
        <span class="badge-desc">Most opening kills (pre-11pm)</span>
      </div>
      <div class="badge" style="--badge-color: #f5a623">
        <span class="badge-icon">&#9670;</span>
        <span class="badge-name">GAMING CHAIR SCIENTIST</span>
        <span class="badge-desc">Discovered the 11pm phenomenon</span>
      </div>
      <div class="badge" style="--badge-color: #17ecc2">
        <span class="badge-icon">&#9760;</span>
        <span class="badge-name">CHAMBER SURVIVOR</span>
        <span class="badge-desc">Lived through the 2023 experiment</span>
      </div>
      <div class="badge" style="--badge-color: #f5d623">
        <span class="badge-icon">&#9829;</span>
        <span class="badge-name">CATCHPHRASE SPECIALIST</span>
        <span class="badge-desc">"Fuck you Chill Good Night" x10,000</span>
      </div>
    </div>
  </section>

  <section class="player-stats" style={`--accent: ${player.accent}`}>
    <div class="stats-grid">
      <div class="stat-block"><span class="stat-value">{player.stats.kd}</span><span class="stat-key">K/D RATIO</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.hs}</span><span class="stat-key">HEADSHOT %</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.wr}</span><span class="stat-key">WIN RATE</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.dmg}</span><span class="stat-key">DMG / RND</span></div>
      <div class="stat-block"><span class="stat-value">{player.rank}</span><span class="stat-key">RANK</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.matches}</span><span class="stat-key">MATCHES</span></div>
    </div>
  </section>

  <TrackerStats accent={player.accent} agents={player.trackerAgents} weapons={player.trackerWeapons} maps={player.trackerMaps} />

  <section class="player-detail" style={`--accent: ${player.accent}`}>
    <div class="detail-grid">
      <div class="detail-text">
        <div class="detail-section"><h2>THE PLAYER</h2><p>{player.bio}</p></div>
        <div class="detail-section"><h2>PLAYSTYLE</h2><p>{player.playstyle}</p></div>
        <div class="detail-section">
          <h2>HIGHLIGHT REEL</h2>
          <ul class="highlights">{player.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
      </div>
      <div class="detail-images">
        <img src={player.image} alt={player.name} class="detail-img-main" />
        <img src={player.extra} alt="" class="detail-img-extra" />
      </div>
    </div>
  </section>
  <PlayerPageStyles />
</Layout>
