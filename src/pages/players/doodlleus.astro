---
import Layout from '../../layouts/Layout.astro';
import TrackerStats from '../../components/TrackerStats.astro';

const player = {
  name: "DOODLLEUS",
  role: "Duelist",
  agents: "Reyna / Neon",
  quote: "We don't simply 'play', Jack. We perform. We win. We dominate! And when we don't, we blame Good Chill Night.",
  image: "/assets/E8a1_Cineposter_4x5_IG.jpg",
  banner: "/assets/Ep8a1_Defiance_Riot Client Login Page 1440p.png",
  extra: "/assets/China_CG_Sagefire_Full.jpg",
  accent: "#c742f5",
  rank: "Gold 3",
  stats: { kd: "1.23", hs: "12.4%", wr: "51.5%", dmg: "163", adr: "163", matches: "1,088" },
  trackerAgents: [
    { name: "REYNA", matches: 1088, kd: "1.38", wr: "51.5%", acs: "207.3" },
    { name: "SAGE", matches: 105, kd: "1.32", wr: "50.5%", acs: "-" },
    { name: "VIPER", matches: 49, kd: "1.38", wr: "49.0%", acs: "-" },
    { name: "PHOENIX", matches: 91, kd: "1.22", wr: "52.7%", acs: "-" },
    { name: "JETT", matches: 80, kd: "1.21", wr: "52.5%", acs: "-" },
    { name: "KILLJOY", matches: 47, kd: "1.18", wr: "55.3%", acs: "-" },
  ],
  trackerWeapons: [
    { name: "VANDAL", kills: 11672, hs: "18.2%" },
    { name: "PHANTOM", kills: 4101, hs: "15.9%" },
    { name: "OPERATOR", kills: 3105, hs: "9.8%" },
  ],
  trackerMaps: [
    { name: "SPLIT", wr: "60%", record: "138W-73L", kd: "1.28" },
    { name: "HAVEN", wr: "54%", record: "158W-94L", kd: "1.24" },
    { name: "BIND", wr: "52%", record: "133W-127L", kd: "1.37" },
    { name: "SUNSET", wr: "54%", record: "43W-25L", kd: "1.22" },
    { name: "BREEZE", wr: "55%", record: "50W-35L", kd: "1.21" },
    { name: "ICEBOX", wr: "46%", record: "72W-81L", kd: "1.35" },
    { name: "ASCENT", wr: "46%", record: "124W-119L", kd: "1.25" },
    { name: "PEARL", wr: "36%", record: "29W-42L", kd: "1.18" },
  ],
  bio: "The heart and soul of tHeRe's nO WaY We lOsE ThIs. Every single game night begins the same way: Doodlleus dropping a cryptic one-word message in the group chat. 'Sploink?' 'Oingoboingo?' 'Chimchimcheroo?' 'Boom boom pow?' If Doodlleus doesn't ask, the squad doesn't play. The man has kids to Calpol and early mornings to survive, but he will ALWAYS find time to try and assemble the 5-stack. Valorant has shown us that this is, in his own words, 'a good gaming chair that loses its power after 11pm.' He once tried Chamber. We don't talk about that. He also once blue-screened mid-session and came back like nothing happened. A tinkerer by day — builds AI image boxes with buttons, does woodworking — and a Reyna main by night. Fuelled entirely by late-night coffee, the unshakeable belief that tonight is the night they hit Plat, and an inexhaustible supply of 'Fuck you Good Chill Night' for every conceivable situation. Good round? 'Fuck you Good Chill Night.' Bad round? 'Fuck you Good Chill Night.' Good Chill Night gets MVP? Believe it or not, 'Fuck you Good Chill Night.'",
  playstyle: "Reyna when the vibes say 'feast mode.' Neon when the vibes say 'I have thirty seconds of gaming chair power left.' A genuine menace in the first few games of the night. The gaming chair is scientifically proven to lose all power at 11pm sharp. Before that? Cracked aim, disgusting Reyna dismisses, Neon slides that make the enemy team type '???' in all chat. After that? A man desperately trying to stay awake while his K/D crumbles. Always happy though. Always. Even at 0-12. 'I'm always happy,' he says, through gritted teeth.",
  highlights: [
    "The 'Sploink?' heard round the world — rallied the squad from a 0-game night to a 5-game session",
    "Blue-screened mid-clutch, reconnected, and pretended nothing happened",
    "The Chamber experiment of 2023 — a dark chapter in squad history, never to be repeated",
    "Has said 'Fuck you Good Chill Night' more times than he's said 'games tonight?' — and that's saying something"
  ]
};
---

<Layout title={`${player.name} // tHeRe's nO WaY We lOsE ThIs`}>
  <!-- ENTRANCE ANIMATION -->
  <div class="entrance-overlay" id="entrance-overlay">
    <div class="entrance-content">
      <div class="entrance-agent">{player.agents}</div>
      <div class="entrance-name" style={`color: ${player.accent}`}>{player.name}</div>
      <div class="entrance-role">{player.role}</div>
    </div>
  </div>

  <section class="player-hero" style={`--accent: ${player.accent}`}>
    <div class="hero-bg parallax-bg" id="parallax-bg">
      <img src={player.banner} alt="" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <a href="/" class="back-link">&larr; BACK TO SQUAD</a>
      <div class="player-agents">{player.agents}</div>
      <h1 class="player-name">{player.name}</h1>
      <div class="player-role">{player.role}</div>
      <p class="player-quote">"{player.quote}"</p>
    </div>
  </section>

  <!-- ACHIEVEMENT BADGES -->
  <section class="badges-section" style={`--accent: ${player.accent}`}>
    <h2 class="badges-title">ACHIEVEMENTS</h2>
    <div class="badges-grid">
      <div class="badge" style="--badge-color: #c742f5">
        <span class="badge-icon">&#9733;</span>
        <span class="badge-name">SQUAD INITIATOR</span>
        <span class="badge-desc">Starts every game night</span>
      </div>
      <div class="badge" style="--badge-color: #ff4655">
        <span class="badge-icon">&#9889;</span>
        <span class="badge-name">FIRST BLOOD KING</span>
        <span class="badge-desc">Most opening kills (pre-11pm)</span>
      </div>
      <div class="badge" style="--badge-color: #f5a623">
        <span class="badge-icon">&#9670;</span>
        <span class="badge-name">GAMING CHAIR SCIENTIST</span>
        <span class="badge-desc">Discovered the 11pm phenomenon</span>
      </div>
      <div class="badge" style="--badge-color: #17ecc2">
        <span class="badge-icon">&#9760;</span>
        <span class="badge-name">CHAMBER SURVIVOR</span>
        <span class="badge-desc">Lived through the 2023 experiment</span>
      </div>
      <div class="badge" style="--badge-color: #f5d623">
        <span class="badge-icon">&#9829;</span>
        <span class="badge-name">CATCHPHRASE SPECIALIST</span>
        <span class="badge-desc">"Fuck you Good Chill Night" x10,000</span>
      </div>
    </div>
  </section>

  <section class="player-stats" style={`--accent: ${player.accent}`}>
    <div class="stats-grid">
      <div class="stat-block"><span class="stat-value">{player.stats.kd}</span><span class="stat-key">K/D RATIO</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.hs}</span><span class="stat-key">HEADSHOT %</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.wr}</span><span class="stat-key">WIN RATE</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.dmg}</span><span class="stat-key">DMG / RND</span></div>
      <div class="stat-block"><span class="stat-value">{player.rank}</span><span class="stat-key">RANK</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.matches}</span><span class="stat-key">MATCHES</span></div>
    </div>
  </section>

  <TrackerStats accent={player.accent} agents={player.trackerAgents} weapons={player.trackerWeapons} maps={player.trackerMaps} />

  <section class="player-detail" style={`--accent: ${player.accent}`}>
    <div class="detail-grid">
      <div class="detail-text">
        <div class="detail-section"><h2>THE PLAYER</h2><p>{player.bio}</p></div>
        <div class="detail-section"><h2>PLAYSTYLE</h2><p>{player.playstyle}</p></div>
        <div class="detail-section">
          <h2>HIGHLIGHT REEL</h2>
          <ul class="highlights">{player.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
      </div>
      <div class="detail-images">
        <img src={player.image} alt={player.name} class="detail-img-main" />
        <img src={player.extra} alt="" class="detail-img-extra" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .player-hero { position: relative; height: 70vh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,16,24,0.3) 0%, rgba(10,16,24,0.9) 80%, var(--val-darker) 100%), linear-gradient(90deg, rgba(10,16,24,0.6) 0%, transparent 60%); }
  .hero-content { position: relative; z-index: 2; padding: 4rem; }
  .back-link { display: inline-block; color: var(--val-cream); text-decoration: none; font-size: 0.75rem; letter-spacing: 3px; opacity: 0.5; margin-bottom: 2rem; transition: all 0.3s; }
  .back-link:hover { opacity: 1; color: var(--accent); }
  .player-agents { font-size: 0.75rem; letter-spacing: 4px; color: var(--accent); font-weight: 700; }
  .player-name { font-size: clamp(3rem, 10vw, 7rem); font-weight: 700; letter-spacing: 6px; line-height: 0.9; margin: 0.5rem 0; }
  .player-role { font-size: 0.9rem; letter-spacing: 4px; opacity: 0.4; }
  .player-quote { margin-top: 1.5rem; font-size: 1.2rem; font-style: italic; opacity: 0.6; letter-spacing: 1px; }
  .player-stats { padding: 4rem; border-top: 1px solid rgba(236,232,225,0.05); border-bottom: 1px solid rgba(236,232,225,0.05); }
  .stats-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(6, 1fr); gap: 2rem; }
  .stat-block { text-align: center; }
  .stat-value { display: block; font-size: 2.5rem; font-weight: 700; color: var(--accent); }
  .stat-key { display: block; font-size: 0.6rem; letter-spacing: 3px; opacity: 0.4; margin-top: 0.5rem; font-weight: 600; }
  .player-detail { padding: 6rem 4rem; max-width: 1200px; margin: 0 auto; }
  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .detail-section { margin-bottom: 3rem; }
  .detail-section h2 { font-size: 0.8rem; letter-spacing: 4px; color: var(--accent); margin-bottom: 1rem; font-weight: 700; }
  .detail-section p { font-size: 1.05rem; line-height: 1.8; opacity: 0.7; }
  .highlights { list-style: none; }
  .highlights li { padding: 0.75rem 0; border-bottom: 1px solid rgba(236,232,225,0.05); font-size: 0.95rem; opacity: 0.7; padding-left: 1.5rem; position: relative; }
  .highlights li::before { content: '//'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
  .detail-images { display: flex; flex-direction: column; gap: 1.5rem; }
  .detail-img-main { width: 100%; aspect-ratio: 4/5; object-fit: cover; clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px)); }
  .detail-img-extra { width: 100%; aspect-ratio: 16/9; object-fit: cover; opacity: 0.7; clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px)); }
  /* ENTRANCE ANIMATION */
  .entrance-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: var(--val-darker);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: entranceFade 0.5s ease 1.5s forwards;
    pointer-events: none;
  }
  .entrance-content { text-align: center; animation: entranceSlide 0.8s ease; }
  .entrance-agent { font-size: 0.7rem; letter-spacing: 6px; opacity: 0.4; font-weight: 600; animation: entrancePop 0.3s ease 0.2s both; }
  .entrance-name { font-size: clamp(3rem, 12vw, 8rem); font-weight: 700; letter-spacing: 8px; line-height: 0.9; animation: entrancePop 0.4s ease 0.4s both; text-shadow: 0 0 60px currentColor; }
  .entrance-role { font-size: 0.8rem; letter-spacing: 4px; opacity: 0.3; margin-top: 1rem; animation: entrancePop 0.3s ease 0.6s both; }
  @keyframes entrancePop { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes entranceSlide { from { transform: scale(1.1); } to { transform: scale(1); } }
  @keyframes entranceFade { to { opacity: 0; visibility: hidden; } }

  /* PARALLAX HERO */
  .parallax-bg img { transition: transform 0.1s linear; }

  /* ACHIEVEMENT BADGES */
  .badges-section {
    padding: 3rem 4rem;
    border-bottom: 1px solid rgba(236,232,225,0.05);
  }
  .badges-title {
    font-size: 0.7rem;
    letter-spacing: 4px;
    color: var(--accent);
    font-weight: 700;
    text-align: center;
    margin-bottom: 2rem;
  }
  .badges-grid {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
  }
  .badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.2rem 1.5rem;
    background: rgba(236,232,225,0.03);
    border: 1px solid rgba(236,232,225,0.06);
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
    transition: all 0.3s;
    min-width: 150px;
  }
  .badge:hover {
    border-color: var(--badge-color);
    background: rgba(236,232,225,0.06);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3), 0 0 20px color-mix(in srgb, var(--badge-color) 15%, transparent);
  }
  .badge-icon { font-size: 1.5rem; color: var(--badge-color); text-shadow: 0 0 10px var(--badge-color); }
  .badge-name { font-size: 0.6rem; letter-spacing: 2px; font-weight: 700; text-align: center; }
  .badge-desc { font-size: 0.55rem; letter-spacing: 1px; opacity: 0.4; text-align: center; }

  @media (max-width: 768px) { .stats-grid { grid-template-columns: repeat(3, 1fr); } .detail-grid { grid-template-columns: 1fr; } .hero-content { padding: 2rem; } .player-detail { padding: 4rem 2rem; } .badges-section { padding: 2rem 1.5rem; } .badge { min-width: 120px; } }
</style>

<script>
  // Parallax effect on hero banner
  const parallaxBg = document.getElementById('parallax-bg');
  if (parallaxBg) {
    const img = parallaxBg.querySelector('img');
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const heroHeight = parallaxBg.parentElement?.offsetHeight || 600;
      if (scrollY < heroHeight && img) {
        img.style.transform = `translateY(${scrollY * 0.3}px) scale(1.1)`;
      }
    });
  }
</script>
