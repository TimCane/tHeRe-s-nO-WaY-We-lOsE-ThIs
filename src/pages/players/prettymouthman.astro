---
import Layout from '../../layouts/Layout.astro';
import TrackerStats from '../../components/TrackerStats.astro';
import PlayerPageStyles from '../../components/PlayerPageStyles.astro';

const player = {
  name: "PRETTY MOUTH MAN",
  role: "Controller",
  agents: "Brimstone",
  quote: "Hopefully we all find some skill under the tree this year.",
  image: "/assets/FirstLook_ClassicRevolverConcept_VALORANT.jpg",
  banner: "/assets/Valorant_Launch_KV_424_designpass_F.jpg",
  extra: "/assets/FirstLook_KingdomConcept_VALORANT.jpg",
  accent: "#f5a623",
  rank: "Gold 3",
  stats: { kd: "1.21", hs: "13.5%", wr: "53.3%", dmg: "118.6", adr: "118.6", matches: "735" },
  trackerAgents: [
    { name: "SAGE", matches: 210, kd: "1.24", wr: "55.2%" },
    { name: "FADE", matches: 125, kd: "1.18", wr: "52.0%" },
    { name: "ISO", matches: 95, kd: "1.15", wr: "49.5%" },
    { name: "BRIMSTONE", matches: 80, kd: "1.22", wr: "53.8%" },
    { name: "PHOENIX", matches: 65, kd: "1.19", wr: "50.8%" },
    { name: "OMEN", matches: 55, kd: "1.25", wr: "56.4%" },
  ],
  trackerWeapons: [
    { name: "VANDAL", kills: 3200, hs: "14.8%" },
    { name: "SPECTRE", kills: 1100, hs: "11.2%" },
    { name: "PHANTOM", kills: 980, hs: "13.1%" },
  ],
  trackerMaps: [
    { name: "SPLIT", wr: "57%", record: "—", kd: "1.28" },
    { name: "BIND", wr: "55%", record: "—", kd: "1.24" },
    { name: "HAVEN", wr: "53%", record: "—", kd: "1.20" },
    { name: "ASCENT", wr: "52%", record: "—", kd: "1.18" },
    { name: "LOTUS", wr: "50%", record: "—", kd: "1.15" },
  ],
  bio: "The man who declared 'not a gamer anymore' and then immediately queued up. Pretty Mouth Man is the squad's Brimstone — smokes, stim beacon, orbital strike, and an alt-tab finger faster than his trigger finger. TJC exposed the meta: 'Pretty Mouth Man dies first so he can play Factorio.' Pretty Mouth Man confirmed it himself: 'I'm tired and want to play Factorio on my main screen.' The man is running two games simultaneously and losing both. His Christmas message to the squad was 'Hopefully we all find some skill under the tree this year' which is the most devastating thing anyone has ever said in a WhatsApp group. Once offered 'half a bar of mini egg chocolate' as a carry incentive. A pipe burst in his garage mid-session and he still considered playing. Does magic tricks for crack heads on street corners on Wednesdays (his words, not ours). Chill Good Night speaks for him often, because they live together and she's faster at typing. Dry humour king. 'Horror.' 'Coward.' 'Purchance.' When he does something good as Brim, the squad types 'That's a brimjob' in chat. He has never asked them to stop.",
  playstyle: "Drops smokes. Tabs to Factorio. Throws molly. Tabs to Factorio. Dies first. Was in Factorio. The squad once suggested he play Sage but TJC shut it down instantly: 'Pretty Mouth Man dies first so he can play Factorio. He isn't a good Sage.' Brimstone is the perfect agent for a man who needs to AFK every 8 seconds to check his iron ore throughput. The orbital strike is basically muscle memory at this point — fire and forget, emphasis on the forget, because he's already back in Factorio. Agreement style: 'purchance.'",
  highlights: [
    "Said 'not a gamer anymore' then played 4 games in a row that same night",
    "Pipe burst in garage mid-session — genuinely weighed up whether to keep playing",
    "The Christmas message: 'Hopefully we all find some skill under the tree this year'",
    "Every good Brim play earns a 'That's a brimjob' in team chat — the tradition endures"
  ]
};
---

<Layout title={`${player.name} // tHeRe's nO WaY We lOsE ThIs`}>
  <div class="entrance-overlay" id="entrance-overlay">
    <div class="entrance-content">
      <div class="entrance-agent">{player.agents}</div>
      <div class="entrance-name" style={`color: ${player.accent}`}>{player.name}</div>
      <div class="entrance-role">{player.role}</div>
    </div>
  </div>

  <section class="player-hero" style={`--accent: ${player.accent}`}>
    <div class="hero-bg parallax-bg" id="parallax-bg">
      <img src={player.banner} alt="" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <a href="/" class="back-link">&larr; BACK TO SQUAD</a>
      <div class="player-agents">{player.agents}</div>
      <h1 class="player-name">{player.name}</h1>
      <div class="player-role">{player.role}</div>
      <p class="player-quote">"{player.quote}"</p>
    </div>
  </section>

  <section class="badges-section" style={`--accent: ${player.accent}`}>
    <h2 class="badges-title">ACHIEVEMENTS</h2>
    <div class="badges-grid">
      <div class="badge" style="--badge-color: #f5a623"><span class="badge-icon">&#9733;</span><span class="badge-name">ALT-TAB SPEEDRUNNER</span><span class="badge-desc">Valorant to Factorio in 0.3s</span></div>
      <div class="badge" style="--badge-color: #ff4655"><span class="badge-icon">&#9760;</span><span class="badge-name">FIRST BLOOD DONOR</span><span class="badge-desc">Dies first every round (for Factorio)</span></div>
      <div class="badge" style="--badge-color: #17ecc2"><span class="badge-icon">&#9670;</span><span class="badge-name">RETIREMENT SPECIALIST</span><span class="badge-desc">"Not a gamer anymore" x47</span></div>
      <div class="badge" style="--badge-color: #c742f5"><span class="badge-icon">&#9889;</span><span class="badge-name">BRIMJOB ARTIST</span><span class="badge-desc">Every good Brim play earns one</span></div>
      <div class="badge" style="--badge-color: #f5d623"><span class="badge-icon">&#9829;</span><span class="badge-name">ROAST MASTER</span><span class="badge-desc">"Find some skill under the tree"</span></div>
    </div>
  </section>

  <section class="player-stats" style={`--accent: ${player.accent}`}>
    <div class="stats-grid">
      <div class="stat-block"><span class="stat-value">{player.stats.kd}</span><span class="stat-key">K/D RATIO</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.hs}</span><span class="stat-key">HEADSHOT %</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.wr}</span><span class="stat-key">WIN RATE</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.dmg}</span><span class="stat-key">DMG / RND</span></div>
      <div class="stat-block"><span class="stat-value">{player.rank}</span><span class="stat-key">RANK</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.matches}</span><span class="stat-key">MATCHES</span></div>
    </div>
  </section>

  <TrackerStats accent={player.accent} agents={player.trackerAgents} weapons={player.trackerWeapons} maps={player.trackerMaps} />

  <section class="player-detail" style={`--accent: ${player.accent}`}>
    <div class="detail-grid">
      <div class="detail-text">
        <div class="detail-section"><h2>THE PLAYER</h2><p>{player.bio}</p></div>
        <div class="detail-section"><h2>PLAYSTYLE</h2><p>{player.playstyle}</p></div>
        <div class="detail-section">
          <h2>HIGHLIGHT REEL</h2>
          <ul class="highlights">{player.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
      </div>
      <div class="detail-images">
        <img src={player.image} alt={player.name} class="detail-img-main" />
        <img src={player.extra} alt="" class="detail-img-extra" />
      </div>
    </div>
  </section>
  <PlayerPageStyles />
</Layout>
