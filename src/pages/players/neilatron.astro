---
import Layout from '../../layouts/Layout.astro';
import TrackerStats from '../../components/TrackerStats.astro';
import PlayerPageStyles from '../../components/PlayerPageStyles.astro';

const player = {
  name: "NEILATRON",
  role: "Flex / Initiator",
  agents: "Gekko / Clove / Raze",
  quote: "I don't want to win for me. I want to win for us.",
  image: "/assets/Gekko_Dark_1.png",
  banner: "/assets/Ep6_2_KeyArt_BM_4k_Gekko_CENTERED_1.jpg",
  extra: "/assets/Gekko_Purple_.png",
  accent: "#7aff4a",
  rank: "Gold 3",
  stats: { kd: "1.03", hs: "12.9%", wr: "49.1%", dmg: "148", adr: "148", matches: "1,500+" },
  trackerAgents: [
    { name: "GEKKO", matches: 540, kd: "1.05", wr: "51.8%" },
    { name: "CLOVE", matches: 310, kd: "1.02", wr: "48.1%" },
    { name: "RAZE", matches: 195, kd: "1.00", wr: "47.2%" },
    { name: "REYNA", matches: 105, kd: "1.14", wr: "54.5%" },
    { name: "SOVA", matches: 87, kd: "0.98", wr: "46.4%" },
  ],
  trackerWeapons: [
    { name: "VANDAL", kills: 4800, hs: "14.2%" },
    { name: "PHANTOM", kills: 2100, hs: "12.8%" },
    { name: "SPECTRE", kills: 890, hs: "10.5%" },
  ],
  trackerMaps: [
    { name: "HAVEN", wr: "65%", record: "—", kd: "1.10" },
    { name: "LOTUS", wr: "60%", record: "—", kd: "1.06" },
    { name: "SPLIT", wr: "52%", record: "—", kd: "1.03" },
    { name: "BIND", wr: "50%", record: "—", kd: "1.01" },
    { name: "ASCENT", wr: "48%", record: "—", kd: "0.98" },
  ],
  bio: "The eternal 'Aye' man. Ask Neilatron if he's playing tonight and you'll get one of three responses: 'Aye', 'I could be persuaded', or 'Im up for losing some rr.' That last one is both a prediction and a promise. Always available, rarely enthusiastic, perpetually 'very sleepy' or 'knackered.' When Meta AI was asked what the odds were of Neilatron dying in enemy spawn, it said 'Pretty high, if history's anything to go by!' — and Meta AI has never been more correct about anything. Between matches he plays Slay the Spire. During matches he's sometimes also playing Slay the Spire. Moved house during the gaming era and emerged from the chaos with a very yellow office and the exact same rank.",
  playstyle: "Three agents deep and every single one of them ends up in enemy spawn somehow. Gekko utility goes in, Neilatron follows, Neilatron dies. Clove smokes go down, Neilatron pushes through, Neilatron dies. Raze satchels forward, Neilatron lands in the enemy team, Neilatron dies. The man said 'I don't want to win for me. I want to win for us' — and he said it sarcastically, which somehow makes it the most honest thing anyone on this team has ever said. Always sleepy, always there, always dying in places he shouldn't be.",
  highlights: [
    "Meta AI roasted his spawn-death rate unprompted — 'Pretty high, if history's anything to go by!'",
    "Said 'Aye' to playing, then fell asleep before the lobby loaded",
    "Survived an entire half without dying in enemy spawn — the squad considered retiring his jersey",
    "The very yellow office reveal — the squad was not prepared"
  ]
};
---

<Layout title={`${player.name} // tHeRe's nO WaY We lOsE ThIs`}>
  <div class="entrance-overlay" id="entrance-overlay">
    <div class="entrance-content">
      <div class="entrance-agent">{player.agents}</div>
      <div class="entrance-name" style={`color: ${player.accent}`}>{player.name}</div>
      <div class="entrance-role">{player.role}</div>
    </div>
  </div>

  <section class="player-hero" style={`--accent: ${player.accent}`}>
    <div class="hero-bg parallax-bg" id="parallax-bg">
      <img src={player.banner} alt="" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <a href="/" class="back-link">&larr; BACK TO SQUAD</a>
      <div class="player-agents">{player.agents}</div>
      <h1 class="player-name">{player.name}</h1>
      <div class="player-role">{player.role}</div>
      <p class="player-quote">"{player.quote}"</p>
    </div>
  </section>

  <section class="badges-section" style={`--accent: ${player.accent}`}>
    <h2 class="badges-title">ACHIEVEMENTS</h2>
    <div class="badges-grid">
      <div class="badge" style="--badge-color: #7aff4a"><span class="badge-icon">&#9733;</span><span class="badge-name">THE ETERNAL AYE</span><span class="badge-desc">Always says yes. Sometimes shows up.</span></div>
      <div class="badge" style="--badge-color: #ff4655"><span class="badge-icon">&#9760;</span><span class="badge-name">SPAWN DEATH SPECIALIST</span><span class="badge-desc">Meta AI confirmed it</span></div>
      <div class="badge" style="--badge-color: #f5a623"><span class="badge-icon">&#9670;</span><span class="badge-name">NARCOLEPSY RISK</span><span class="badge-desc">Fell asleep before lobby loaded</span></div>
      <div class="badge" style="--badge-color: #17ecc2"><span class="badge-icon">&#9889;</span><span class="badge-name">RR PHILANTHROPIST</span><span class="badge-desc">"Im up for losing some rr"</span></div>
      <div class="badge" style="--badge-color: #c742f5"><span class="badge-icon">&#9829;</span><span class="badge-name">YELLOW OFFICE OWNER</span><span class="badge-desc">Very yellow. Same rank.</span></div>
    </div>
  </section>

  <section class="player-stats" style={`--accent: ${player.accent}`}>
    <div class="stats-grid">
      <div class="stat-block"><span class="stat-value">{player.stats.kd}</span><span class="stat-key">K/D RATIO</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.hs}</span><span class="stat-key">HEADSHOT %</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.wr}</span><span class="stat-key">WIN RATE</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.dmg}</span><span class="stat-key">DMG / RND</span></div>
      <div class="stat-block"><span class="stat-value">{player.rank}</span><span class="stat-key">RANK</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.matches}</span><span class="stat-key">MATCHES</span></div>
    </div>
  </section>

  <TrackerStats accent={player.accent} agents={player.trackerAgents} weapons={player.trackerWeapons} maps={player.trackerMaps} />

  <section class="player-detail" style={`--accent: ${player.accent}`}>
    <div class="detail-grid">
      <div class="detail-text">
        <div class="detail-section"><h2>THE PLAYER</h2><p>{player.bio}</p></div>
        <div class="detail-section"><h2>PLAYSTYLE</h2><p>{player.playstyle}</p></div>
        <div class="detail-section">
          <h2>HIGHLIGHT REEL</h2>
          <ul class="highlights">{player.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
      </div>
      <div class="detail-images">
        <img src={player.image} alt={player.name} class="detail-img-main" />
        <img src={player.extra} alt="" class="detail-img-extra" />
      </div>
    </div>
  </section>
  <PlayerPageStyles />
</Layout>
