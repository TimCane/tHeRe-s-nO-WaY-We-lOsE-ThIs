---
import Layout from '../../layouts/Layout.astro';
import TrackerStats from '../../components/TrackerStats.astro';
import PlayerPageStyles from '../../components/PlayerPageStyles.astro';

const player = {
  name: "TJC",
  role: "Support / Controller",
  agents: "Sage / Viper",
  quote: "This is why im the viper.",
  image: "/assets/FirstLook_SageHealConcept.jpg",
  banner: "/assets/VALORANT_Viper.jpg",
  extra: "/assets/FirstLook_Viper_Concept.jpg",
  accent: "#17ecc2",
  rank: "Gold 2",
  stats: { kd: "0.85", hs: "17.8%", wr: "51.2%", dmg: "134.3", adr: "134.3", matches: "1,204" },
  trackerAgents: [
    { name: "SAGE", matches: 460, kd: "0.88", wr: "51.2%" },
    { name: "VIPER", matches: 184, kd: "0.84", wr: "49.8%" },
    { name: "OMEN", matches: 102, kd: "0.82", wr: "48.1%" },
    { name: "KILLJOY", matches: 61, kd: "0.86", wr: "52.6%" },
    { name: "BRIMSTONE", matches: 38, kd: "0.90", wr: "54.5%" },
  ],
  trackerWeapons: [
    { name: "VANDAL", kills: 2934, hs: "17.8%" },
    { name: "PHANTOM", kills: 2202, hs: "15.2%" },
    { name: "SPECTRE", kills: 674, hs: "12.1%" },
  ],
  trackerMaps: [
    { name: "HAVEN", wr: "52%", record: "148W-136L", kd: "0.87" },
    { name: "BIND", wr: "49%", record: "139W-145L", kd: "0.85" },
    { name: "ASCENT", wr: "50%", record: "143W-143L", kd: "0.87" },
    { name: "SPLIT", wr: "51%", record: "133W-121L", kd: "0.89" },
    { name: "ICEBOX", wr: "48%", record: "91W-99L", kd: "0.93" },
    { name: "LOTUS", wr: "54%", record: "54W-47L", kd: "0.86" },
  ],
  bio: "Self-proclaimed best Sage in the squad. The whole squad suspects TJC is actually a ChatGPT instance that gained sentience and started playing Valorant. Every message opens with 'Ah yep -- classic' like a large language model with a Scouts leadership badge. 'Ah, yep -- the classic Neilatron wanting to win at Valorant conundrum' is an actual thing TJC said. The squad roasted him for being AI and he never denied it. Has a cat with diabetes, dual-boots into a 'Valorant OS' for game nights, falls asleep and misses entire sessions ('Ive not fallen asleep like last night'), and once announced he shits blood after spicy food then immediately pivoted to 'games tonight?' His commitment level is legendary: 'I could do exactly one.' Needs a minute to think after getting off the sofa. Picks up his wife from the station. Goes to Scouts. Somehow still finds time to bait rez every teammate who dies in the open. Also uses the Wasteland Vandal. Unironically. In 2026. The squad has staged multiple interventions. He will not change it.",
  playstyle: "The bait rez specialist. Teammate dies in the open? TJC will rez them right there. No smoke. No wall. Just vibes. 'You have to heal people' is his biggest gripe about other Sage players, which is rich coming from a man whose rezzes have a 12% survival rate. Also the squad's intelligence analyst — it was TJC who exposed the Pretty Mouth Boy Factorio meta: 'Pretty Mouth Boy dies first so he can play Factorio.' He said it. It's canon. Between the Crashout memes, the AI-patterned speech, and the Valorant OS dual-boot setup, TJC is either the most committed player on the squad or the most elaborate bot Riot has ever failed to detect.",
  highlights: [
    "Exposed the Pretty Mouth Boy Factorio meta — 'Pretty Mouth Boy dies first so he can play Factorio'",
    "Fell asleep and missed an entire gaming session — the squad played a 4-stack and won more",
    "The Crashout meme era — sent it so many times the group chat became a Crashout archive",
    "Uses the Wasteland Vandal unironically — the squad has given up trying to change him"
  ]
};
---

<Layout title={`${player.name} // tHeRe's nO WaY We lOsE ThIs`}>
  <div class="entrance-overlay" id="entrance-overlay">
    <div class="entrance-content">
      <div class="entrance-agent">{player.agents}</div>
      <div class="entrance-name" style={`color: ${player.accent}`}>{player.name}</div>
      <div class="entrance-role">{player.role}</div>
    </div>
  </div>

  <section class="player-hero" style={`--accent: ${player.accent}`}>
    <div class="hero-bg parallax-bg" id="parallax-bg">
      <img src={player.banner} alt="" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <a href="/" class="back-link">&larr; BACK TO SQUAD</a>
      <div class="player-agents">{player.agents}</div>
      <h1 class="player-name">{player.name}</h1>
      <div class="player-role">{player.role}</div>
      <p class="player-quote">"{player.quote}"</p>
    </div>
  </section>

  <section class="badges-section" style={`--accent: ${player.accent}`}>
    <h2 class="badges-title">ACHIEVEMENTS</h2>
    <div class="badges-grid">
      <div class="badge" style="--badge-color: #17ecc2"><span class="badge-icon">&#9760;</span><span class="badge-name">BAIT REZ SPECIALIST</span><span class="badge-desc">12% survival rate and counting</span></div>
      <div class="badge" style="--badge-color: #ff4655"><span class="badge-icon">&#9733;</span><span class="badge-name">INTEL ANALYST</span><span class="badge-desc">Exposed the Factorio meta</span></div>
      <div class="badge" style="--badge-color: #f5a623"><span class="badge-icon">&#9670;</span><span class="badge-name">CRASHOUT PIONEER</span><span class="badge-desc">Made CRASHOUT a way of life</span></div>
      <div class="badge" style="--badge-color: #c742f5"><span class="badge-icon">&#9889;</span><span class="badge-name">VALORANT OS ENGINEER</span><span class="badge-desc">Dual-boots for game night</span></div>
      <div class="badge" style="--badge-color: #f5d623"><span class="badge-icon">&#9829;</span><span class="badge-name">WASTELAND VANDAL LOYALIST</span><span class="badge-desc">Unironically. In 2026.</span></div>
    </div>
  </section>

  <section class="player-stats" style={`--accent: ${player.accent}`}>
    <div class="stats-grid">
      <div class="stat-block"><span class="stat-value">{player.stats.kd}</span><span class="stat-key">K/D RATIO</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.hs}</span><span class="stat-key">HEADSHOT %</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.wr}</span><span class="stat-key">WIN RATE</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.dmg}</span><span class="stat-key">DMG / RND</span></div>
      <div class="stat-block"><span class="stat-value">{player.rank}</span><span class="stat-key">RANK</span></div>
      <div class="stat-block"><span class="stat-value">{player.stats.matches}</span><span class="stat-key">MATCHES</span></div>
    </div>
  </section>

  <TrackerStats accent={player.accent} agents={player.trackerAgents} weapons={player.trackerWeapons} maps={player.trackerMaps} />

  <section class="player-detail" style={`--accent: ${player.accent}`}>
    <div class="detail-grid">
      <div class="detail-text">
        <div class="detail-section"><h2>THE PLAYER</h2><p>{player.bio}</p></div>
        <div class="detail-section"><h2>PLAYSTYLE</h2><p>{player.playstyle}</p></div>
        <div class="detail-section">
          <h2>HIGHLIGHT REEL</h2>
          <ul class="highlights">{player.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
      </div>
      <div class="detail-images">
        <img src={player.image} alt={player.name} class="detail-img-main" />
        <img src={player.extra} alt="" class="detail-img-extra" />
      </div>
    </div>
  </section>
  <PlayerPageStyles />
</Layout>
