const types = ['all', 'chat', 'scoreboard', 'quote', 'moment'];
const typeLabels: Record<string, string> = { all: 'ALL', chat: 'CHAT LOGS', scoreboard: 'SCOREBOARDS', quote: 'QUOTES', moment: 'MOMENTS' };
const allPlayers = ['Doodlleus', 'TJC', 'Pretty Mouth Boy', 'Chill Good Night', 'Neilatron'];
---

<Layout title="MEME WALL // tHeRe's nO WaY We lOsE ThIs&trade;">
  <section class="meme-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <a href="/" class="back-link">&larr; BACK TO BASE</a>
      <span class="section-tag">// HALL OF FAME</span>
      <h1>THE MEME WALL</h1>
      <p class="hero-sub">IMMORTALIZED MOMENTS OF GREATNESS AND DISGRACE</p>
    </div>
  </section>

  <section class="filter-bar">
    <div class="filter-group">
      <span class="filter-label">TYPE</span>
      <div class="filter-buttons" id="type-filters">
        {types.map(t => (
          <button class={`filter-btn ${t === 'all' ? 'active' : ''}`} data-type={t}>{typeLabels[t]}</button>
        ))}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">PLAYER</span>
      <div class="filter-buttons" id="player-filters">
        <button class="filter-btn active" data-player="all">ALL</button>
        {allPlayers.map(p => (
          <button class="filter-btn" data-player={p} style={`--player-color: ${playerColors[p as keyof typeof playerColors]}`}>{p.toUpperCase()}</button>
        ))}
      </div>
    </div>
  </section>

  <section class="meme-grid" id="meme-grid">
    {memes.map((meme) => {
      if (meme.type === 'chat') {
        return (
          <div class="meme-card card-chat" data-type={meme.type} data-players={meme.players.join(',')}>
            <div class="card-header">
              <span class="card-type-tag tag-chat">CHAT LOG</span>
              <span class="card-number">#{String(meme.id).padStart(2, '0')}</span>
            </div>
            <h3 class="card-title">{meme.title}</h3>
            <div class="chat-window">
              {meme.messages.map(msg => (
                msg.user ? (
                  <div class="chat-msg">
                    <span class="chat-time">{msg.time}</span>
                    <span class="chat-user" style={`color: ${playerColors[msg.user as keyof typeof playerColors] || '#ece8e1'}`}>{msg.user}</span>
                    <span class="chat-text">{msg.text}</span>
                  </div>
                ) : (
                  <div class="chat-gap">
                    <span>{msg.text}</span>
                  </div>
                )
              ))}
            </div>
          </div>
        );
      }

      if (meme.type === 'scoreboard') {
        return (
          <div class="meme-card card-scoreboard" data-type={meme.type} data-players={meme.players.join(',')}>
            <div class="card-header">
              <span class="card-type-tag tag-scoreboard">SCOREBOARD</span>
              <span class="card-number">#{String(meme.id).padStart(2, '0')}</span>
            </div>
            <h3 class="card-title">{meme.title}</h3>
            <div class="scoreboard">
              <div class="scoreboard-header">
                <span class="sb-col sb-player">PLAYER</span>
                <span class="sb-col sb-agent">AGENT</span>
                {meme.stats[0].weapon && <span class="sb-col sb-weapon">WEAPON</span>}
                <span class="sb-col sb-k">K</span>
                <span class="sb-col sb-d">D</span>
                <span class="sb-col sb-a">A</span>
              </div>
              {meme.stats.map(s => (
                <div class={`scoreboard-row ${s.highlight ? 'row-highlight' : ''}`}>
                  <span class="sb-col sb-player" style={`color: ${playerColors[s.name as keyof typeof playerColors] || '#ece8e1'}`}>{s.name}</span>
                  <span class="sb-col sb-agent">{s.agent}</span>
                  {s.weapon && <span class="sb-col sb-weapon">{s.weapon}</span>}
                  <span class="sb-col sb-k">{s.kills}</span>
                  <span class="sb-col sb-d">{s.deaths}</span>
                  <span class="sb-col sb-a">{s.assists}</span>
                </div>
              ))}
            </div>
            <div class="scoreboard-comment">{meme.comment}</div>
          </div>
        );
      }

      if (meme.type === 'quote') {
        return (
          <div class="meme-card card-quote" data-type={meme.type} data-players={meme.players.join(',')}>
            <div class="card-header">
              <span class="card-type-tag tag-quote">QUOTE</span>
              <span class="card-number">#{String(meme.id).padStart(2, '0')}</span>
            </div>
            <h3 class="card-title">{meme.title}</h3>
            <div class="quote-block">
              <div class="quote-mark">&ldquo;</div>
              <p class="quote-text">{meme.quote}</p>
              <div class="quote-attribution">
                <span class="quote-author" style={`color: ${playerColors[meme.attribution as keyof typeof playerColors] || 'var(--val-cream)'}`}>{meme.attribution}</span>
                <span class="quote-context">{meme.context}</span>
              </div>
            </div>
          </div>
        );
      }

      if (meme.type === 'moment') {
        return (
          <div class="meme-card card-moment" data-type={meme.type} data-players={meme.players.join(',')}>
            <div class="card-header">
              <span class="card-type-tag tag-moment">{meme.badge}</span>
              <span class="card-number">#{String(meme.id).padStart(2, '0')}</span>
            </div>
            <div class="moment-badge-wrap">
              <span class={`moment-badge ${meme.badge === 'LEGENDARY' ? 'badge-legendary' : 'badge-hof'}`}>{meme.badge}</span>
            </div>
            <h3 class="card-title moment-title">{meme.title}</h3>
            <p class="moment-detail">{meme.detail}</p>
            <p class="moment-desc">{meme.description}</p>
          </div>
        );
      }

      return null;
    })}
  </section>
</Layout>

<script is:inline>
(function() {
  const typeButtons = document.querySelectorAll('#type-filters .filter-btn');
  const playerButtons = document.querySelectorAll('#player-filters .filter-btn');
  const cards = document.querySelectorAll('.meme-card');

  let activeType = 'all';
  let activePlayer = 'all';

  function filterCards() {
    cards.forEach(function(card) {
      const cardType = card.getAttribute('data-type');
      const cardPlayers = card.getAttribute('data-players') || '';
      const typeMatch = activeType === 'all' || cardType === activeType;
      const playerMatch = activePlayer === 'all' || cardPlayers.split(',').indexOf(activePlayer) !== -1;
      if (typeMatch && playerMatch) {
        card.style.display = '';
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          });
        });
      } else {
        card.style.display = 'none';
      }
    });
  }

  typeButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      typeButtons.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      activeType = btn.getAttribute('data-type');
      filterCards();
    });
  });

  playerButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      playerButtons.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      activePlayer = btn.getAttribute('data-player');
      filterCards();
    });
  });
})();
</script>

<style>
  /* ==================== HERO ==================== */
  .meme-hero {
    position: relative;
    padding: 10rem 4rem 4rem;
    background: var(--val-darker);
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(255,70,85,0.08) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 30%, rgba(23,236,194,0.05) 0%, transparent 50%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .back-link {
    display: inline-block;
    color: var(--val-cream);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 3px;
    opacity: 0.5;
    margin-bottom: 2rem;
    transition: all 0.3s;
  }

  .back-link:hover {
    opacity: 1;
    color: var(--val-red);
  }

  .section-tag {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 5px;
    color: var(--val-red);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  h1 {
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: 8px;
    line-height: 1;
    color: var(--val-cream);
  }

  .hero-sub {
    font-size: 0.85rem;
    letter-spacing: 4px;
    opacity: 0.4;
    font-weight: 600;
    margin-top: 1rem;
  }

  /* ==================== FILTER BAR ==================== */
  .filter-bar {
    padding: 2rem 4rem;
    border-bottom: 1px solid rgba(236,232,225,0.06);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    position: sticky;
    top: 60px;
    z-index: 50;
    background: rgba(10,16,24,0.95);
    backdrop-filter: blur(10px);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.65rem;
    letter-spacing: 4px;
    font-weight: 700;
    color: var(--val-red);
    min-width: 60px;
  }

  .filter-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 0.4rem 1rem;
    background: rgba(236,232,225,0.04);
    border: 1px solid rgba(236,232,225,0.08);
    color: var(--val-cream);
    opacity: 0.5;
    transition: all 0.3s;
    cursor: none;
  }

  .filter-btn:hover {
    opacity: 0.8;
    border-color: rgba(236,232,225,0.2);
  }

  .filter-btn.active {
    opacity: 1;
    background: rgba(255,70,85,0.15);
    border-color: var(--val-red);
    color: var(--val-red);
  }

  #player-filters .filter-btn.active {
    background: rgba(236,232,225,0.08);
    border-color: var(--player-color, var(--val-red));
    color: var(--player-color, var(--val-red));
  }

  /* ==================== GRID ==================== */
  .meme-grid {
    padding: 3rem 4rem 6rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 2rem;
    align-items: start;
  }

  /* ==================== CARD BASE ==================== */
  .meme-card {
    background: rgba(15,25,35,0.8);
    border: 1px solid rgba(236,232,225,0.06);
    padding: 1.8rem;
    position: relative;
    transition: all 0.4s ease, opacity 0.3s, transform 0.3s;
    overflow: hidden;
  }

  .meme-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    transition: height 0.3s;
  }

  .meme-card:hover {
    border-color: rgba(236,232,225,0.12);
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .card-type-tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 3px;
    padding: 0.2rem 0.6rem;
  }

  .tag-chat {
    color: #17ecc2;
    background: rgba(23,236,194,0.1);
    border: 1px solid rgba(23,236,194,0.2);
  }

  .tag-scoreboard {
    color: #ff4655;
    background: rgba(255,70,85,0.1);
    border: 1px solid rgba(255,70,85,0.2);
  }

  .tag-quote {
    color: #f5d623;
    background: rgba(245,214,35,0.1);
    border: 1px solid rgba(245,214,35,0.2);
  }

  .tag-moment {
    color: #f5a623;
    background: rgba(245,166,35,0.1);
    border: 1px solid rgba(245,166,35,0.2);
  }

  .card-number {
    font-size: 0.65rem;
    letter-spacing: 2px;
    opacity: 0.25;
    font-weight: 700;
  }

  .card-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--val-cream);
    margin-bottom: 1.2rem;
  }

  /* ==================== CHAT CARD ==================== */
  .card-chat::before { background: #17ecc2; }

  .chat-window {
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(236,232,225,0.04);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-height: 400px;
    overflow-y: auto;
  }

  .chat-msg {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.3rem 0;
  }

  .chat-time {
    font-size: 0.6rem;
    opacity: 0.25;
    white-space: nowrap;
    min-width: 55px;
    letter-spacing: 1px;
  }

  .chat-user {
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    letter-spacing: 1px;
  }

  .chat-text {
    font-size: 0.85rem;
    color: var(--val-cream);
    opacity: 0.9;
  }

  .chat-gap {
    text-align: center;
    padding: 0.5rem 0;
    font-size: 0.65rem;
    letter-spacing: 3px;
    opacity: 0.2;
    font-weight: 600;
