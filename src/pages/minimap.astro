      { label: "CRASHOUT CORRIDOR", x: 50, y: 45, real: "Mid Courtyard" },
      { label: "PRETTY MOUTH BOY WAS IN FACTORIO HERE", x: 20, y: 65, real: "A Site" },
      { label: "DEFUSE (WE'RE ATTACKING)", x: 50, y: 70, real: "B Site" },
      { label: "NEILATRON FELL ASLEEP HERE", x: 82, y: 65, real: "C Site" },
      { label: "THE GARAGE (14 FAILED REZZES)", x: 35, y: 35, real: "Garage" },
    ]
  },
  {
    name: "SPLIT",
    callouts: [
      { label: "5 ODINS GO BRRR", x: 50, y: 20, real: "Mid" },
      { label: "SPLOINK ZONE", x: 20, y: 25, real: "A Main" },
      { label: "THE WASTELAND VANDAL SHRINE", x: 78, y: 25, real: "B Main" },
      { label: "WHERE WE ALL STACK ONE ANGLE", x: 50, y: 50, real: "Mid Mail" },
      { label: "CHILL GOOD NIGHT'S TURRET (MVP)", x: 22, y: 68, real: "A Site" },
      { label: "PURCHANCE POINT", x: 78, y: 68, real: "B Site" },
      { label: "AYE (NEILATRON SPAWN)", x: 50, y: 85, real: "Spawn" },
      { label: "DOODLLEUS LURKS HERE AT 11:01PM", x: 35, y: 40, real: "A Ramps" },
    ]
  },
  {
    name: "ASCENT",
    callouts: [
      { label: "THE FACTORIO GAP", x: 50, y: 30, real: "Mid" },
      { label: "CHAMBER EXPERIMENT MEMORIAL", x: 20, y: 20, real: "A Main" },
      { label: "VIPER WALL (15 DEGREES OFF)", x: 78, y: 22, real: "B Main" },
      { label: "WHERE TJC SAYS 'THIS IS WHY IM THE VIPER'", x: 60, y: 50, real: "Market" },
