---

<Layout title="THE MINIMAP // tHeRe's nO WaY We lOsE ThIs™">
  <section class="minimap-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <a href="/" class="back-link">&larr; BACK TO BASE</a>
      <span class="section-tag">// TACTICAL INTELLIGENCE (INCORRECT)</span>
      <h1>THE MINIMAP</h1>
      <p class="hero-sub">DOODLLEUS HAS NEVER LOOKED AT THIS PAGE</p>
    </div>
  </section>

  <section class="minimap-section">
    <p class="minimap-disclaimer">These callouts have been verified by exactly 0 professional players. All locations are approximate, subjective, and emotionally charged. If you use these in ranked, that's on you.</p>

    <div class="map-tabs" id="map-tabs">
      {maps.map((map, i) => (
        <button class={`map-tab ${i === 0 ? 'active' : ''}`} data-map={i}>{map.name}</button>
      ))}
    </div>

    {maps.map((map, i) => (
      <div class={`map-display ${i === 0 ? 'active' : ''}`} data-map-display={i}>
        <div class="map-container">
          <div class="map-bg">
            <div class="map-grid"></div>
            <div class="map-title">{map.name}</div>
            <div class="map-sites">
              <div class="site site-a">A</div>
              <div class="site site-b">B</div>
              {map.name === "HAVEN" || map.name === "LOTUS" ? <div class="site site-c">C</div> : null}
            </div>
          </div>
          {map.callouts.map((c) => (
            <div class="callout-pin" style={`left: ${c.x}%; top: ${c.y}%`}>
              <div class="pin-dot"></div>
              <div class="pin-label">
                <span class="pin-wrong">{c.label}</span>
                <span class="pin-real">Real: {c.real}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="minimap-footer">
    <div class="footer-quote">
      <p>"The minimap shows enemy positions, teammate locations, and utility placement."</p>
      <p class="quote-response">— DOODLLEUS: "The what?"</p>
    </div>
  </section>

  <script is:inline>
  (function() {
    const tabs = document.querySelectorAll('.map-tab');
    const displays = document.querySelectorAll('.map-display');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var mapIndex = tab.getAttribute('data-map');
        tabs.forEach(function(t) { t.classList.remove('active'); });
        displays.forEach(function(d) { d.classList.remove('active'); });
        tab.classList.add('active');
        var target = document.querySelector('[data-map-display="' + mapIndex + '"]');
        if (target) target.classList.add('active');
      });
    });
  })();
  </script>
</Layout>

<style>
  .minimap-hero {
    position: relative;
    padding: 10rem 4rem 4rem;
    background: var(--val-darker);
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(199,66,245,0.06) 0%, transparent 60%);
  }

  .hero-content { position: relative; z-index: 2; }

  .back-link {
    display: inline-block;
    color: var(--val-cream);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 3px;
    opacity: 0.5;
    margin-bottom: 2rem;
    transition: all 0.3s;
  }
  .back-link:hover { opacity: 1; color: var(--val-red); }

  .section-tag {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 4px;
    color: var(--val-red);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: 6px;
    line-height: 0.9;
  }

  .hero-sub {
    margin-top: 1rem;
    font-size: 1rem;
    letter-spacing: 4px;
    opacity: 0.4;
    font-weight: 600;
    color: #c742f5;
  }

  /* SECTION */
  .minimap-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  .minimap-disclaimer {
    font-size: 0.75rem;
    letter-spacing: 1px;
    opacity: 0.3;
    line-height: 1.6;
    margin-bottom: 3rem;
    text-align: center;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* TABS */
  .map-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .map-tab {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 3px;
    padding: 0.6rem 1.2rem;
    background: rgba(236,232,225,0.03);
    border: 1px solid rgba(236,232,225,0.08);
    color: var(--val-cream);
    opacity: 0.5;
    transition: all 0.3s;
    clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }

  .map-tab:hover {
    opacity: 0.8;
    border-color: rgba(236,232,225,0.2);
  }

  .map-tab.active {
    opacity: 1;
    background: rgba(255,70,85,0.1);
    border-color: var(--val-red);
    color: var(--val-red);
  }

  /* MAP DISPLAY */
  .map-display {
    display: none;
  }
  .map-display.active {
    display: block;
    animation: mapFadeIn 0.4s ease;
  }

  @keyframes mapFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .map-container {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background: #0d1820;
    border: 1px solid rgba(236,232,225,0.08);
    overflow: hidden;
    border-radius: 4px;
  }

  .map-bg {
    position: absolute;
    inset: 0;
  }

  .map-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(236,232,225,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(236,232,225,0.03) 1px, transparent 1px);
    background-size: 10% 10%;
  }

  .map-title {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.6rem;
    letter-spacing: 4px;
    opacity: 0.15;
    font-weight: 700;
  }

  .map-sites {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .site {
    position: absolute;
    width: 50px;
    height: 50px;
    border: 2px solid rgba(255,70,85,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 700;
    color: rgba(255,70,85,0.2);
    letter-spacing: 2px;
  }

  .site-a { top: 55%; left: 15%; }
  .site-b { top: 55%; left: 45%; }
  .site-c { top: 55%; left: 72%; }

  /* CALLOUT PINS */
  .callout-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .pin-dot {
    width: 8px;
    height: 8px;
    background: var(--val-red);
    border-radius: 50%;
    margin: 0 auto;
    box-shadow: 0 0 8px rgba(255,70,85,0.5);
    animation: pinPulse 2s ease-in-out infinite;
    position: relative;
    z-index: 2;
  }

  @keyframes pinPulse {
    0%, 100% { box-shadow: 0 0 8px rgba(255,70,85,0.5); }
    50% { box-shadow: 0 0 15px rgba(255,70,85,0.8), 0 0 30px rgba(255,70,85,0.3); }
  }

  .pin-label {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(10,16,24,0.92);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,70,85,0.2);
    padding: 0.4rem 0.6rem;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s;
    pointer-events: none;
    z-index: 10;
  }

  .callout-pin:hover .pin-label {
    opacity: 1;
    visibility: visible;
  }

  .pin-wrong {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--val-red);
    line-height: 1.3;
  }

  .pin-real {
    display: block;
    font-size: 0.5rem;
    letter-spacing: 1px;
    opacity: 0.3;
    margin-top: 0.2rem;
  }

  /* FOOTER */
  .minimap-footer {
    max-width: 600px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
    text-align: center;
  }

  .footer-quote p {
    font-size: 1.1rem;
    font-style: italic;
    opacity: 0.4;
    line-height: 1.6;
  }

  .quote-response {
    margin-top: 1rem;
    color: #c742f5;
    opacity: 0.7 !important;
    font-style: normal !important;
    font-weight: 700;
    letter-spacing: 2px;
    font-size: 0.85rem !important;
  }

  @media (max-width: 768px) {
    .minimap-hero { padding: 8rem 2rem 3rem; }
    .minimap-section { padding: 2rem 1rem 3rem; }
    .map-container { aspect-ratio: 1/1; }
    .pin-label { display: none; }
    .callout-pin:hover .pin-label { display: block; }
    .map-tab { font-size: 0.6rem; padding: 0.5rem 0.8rem; letter-spacing: 2px; }
  }
</style>
