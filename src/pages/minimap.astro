      { label: "BAIT REZ BOULEVARD", x: 80, y: 55, real: "B Site" },
      { label: "THE SAVE ROUND (LOL)", x: 18, y: 70, real: "A Site" },
      { label: "NEILATRON'S NAP CORNER", x: 55, y: 80, real: "Hookah" },
      { label: "CHILL GOOD NIGHT IS NEAR HERE (SITE ADJACENT)", x: 35, y: 25, real: "A Bath" },
