const mapNames = Object.keys(maps);
---

<Layout title="MAP CALLOUTS // tHeRe's nO WaY We lOsE ThIs™">
  <section class="callouts-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <a href="/" class="back-link">&larr; BACK TO BASE</a>
      <span class="section-tag">// TACTICAL INTEL</span>
      <h1>MAP CALLOUTS</h1>
      <p class="hero-sub">THE SQUAD'S OFFICIAL (UNOFFICIAL) LOCATION NAMES</p>
      <p class="hero-desc">Real callouts are for people who win games. These are for us.</p>
    </div>
  </section>

  <section class="map-tabs-section">
    <div class="map-tabs" id="map-tabs">
      {mapNames.map((name, i) => (
        <button class={`map-tab ${i === 0 ? 'active' : ''}`} data-map={name}>{name}</button>
      ))}
    </div>
  </section>

  <section class="callouts-container" id="callouts-container">
    {mapNames.map((mapName, mi) => (
      <div class={`map-callouts ${mi === 0 ? 'active' : ''}`} data-map-content={mapName}>
        <div class="map-title-bar">
          <div class="map-title-decor"></div>
          <h2 class="map-title">{mapName}</h2>
          <div class="map-title-decor"></div>
        </div>
        <div class="callout-grid">
          {maps[mapName].map((c, ci) => (
            <div class="callout-card" style={`--accent: ${members[c.coined]}; --i: ${ci}`}>
              <div class="callout-header">
                <span class="callout-real">{c.real}</span>
                <span class="callout-arrow">&rarr;</span>
                <span class="callout-squad" style={`color: ${members[c.coined]}`}>{c.squad}</span>
              </div>
              <div class="callout-body">
                <p class="callout-explanation">{c.explanation}</p>
              </div>
              <div class="callout-footer">
                <span class="callout-coined" style={`color: ${members[c.coined]}; border-color: ${members[c.coined]}`}>
                  {c.coined}
                </span>
              </div>
              <div class="callout-glow"></div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <script is:inline>
  (function() {
    const tabs = document.querySelectorAll('.map-tab');
    const panels = document.querySelectorAll('.map-callouts');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const map = tab.getAttribute('data-map');

        tabs.forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');

        panels.forEach(function(p) {
          if (p.getAttribute('data-map-content') === map) {
            p.classList.add('active');
            // Animate cards in
            var cards = p.querySelectorAll('.callout-card');
            cards.forEach(function(card, i) {
              card.style.opacity = '0';
              card.style.transform = 'translateY(20px)';
              setTimeout(function() {
                card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
              }, i * 80);
            });
          } else {
            p.classList.remove('active');
          }
        });
      });
    });
  })();
  </script>
</Layout>

<style>
  /* HERO */
  .callouts-hero {
    position: relative;
    padding: 10rem 4rem 4rem;
    background: var(--val-darker);
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(255,70,85,0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 60%, rgba(23,236,194,0.05) 0%, transparent 50%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .back-link {
    display: inline-block;
    color: var(--val-cream);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 3px;
    opacity: 0.5;
    margin-bottom: 2rem;
    transition: all 0.3s;
  }

  .back-link:hover {
    opacity: 1;
    color: var(--val-red);
  }

  .section-tag {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 4px;
    color: var(--val-red);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .callouts-hero h1 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 4.5rem;
    font-weight: 700;
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--val-cream) 0%, rgba(236,232,225,0.6) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 1.1rem;
    letter-spacing: 5px;
    opacity: 0.5;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .hero-desc {
    font-size: 0.85rem;
    letter-spacing: 2px;
    opacity: 0.35;
    font-weight: 500;
  }

  /* MAP TABS */
  .map-tabs-section {
    position: sticky;
    top: 60px;
    z-index: 50;
    background: rgba(10,16,24,0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,70,85,0.15);
    padding: 0;
  }

  .map-tabs {
    display: flex;
    overflow-x: auto;
    gap: 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .map-tabs::-webkit-scrollbar {
    display: none;
  }

  .map-tab {
    flex: 1 0 auto;
    padding: 1rem 1.5rem;
    background: transparent;
    border: none;
    color: var(--val-cream);
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 3px;
    opacity: 0.4;
    transition: all 0.3s;
    position: relative;
    white-space: nowrap;
  }

  .map-tab:hover {
    opacity: 0.7;
    background: rgba(255,70,85,0.05);
  }

  .map-tab.active {
    opacity: 1;
    color: var(--val-red);
  }

  .map-tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--val-red);
  }

  /* MAP CONTENT PANELS */
  .callouts-container {
    padding: 3rem 4rem 6rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .map-callouts {
    display: none;
  }

  .map-callouts.active {
    display: block;
  }

  .map-title-bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .map-title-decor {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255,70,85,0.3), transparent);
  }

  .map-title-decor:last-child {
    background: linear-gradient(270deg, rgba(255,70,85,0.3), transparent);
  }

  .map-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 10px;
    color: var(--val-red);
  }

  /* CALLOUT CARDS */
  .callout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .callout-card {
    position: relative;
    background: rgba(15,25,35,0.6);
    border: 1px solid rgba(236,232,225,0.06);
    padding: 1.5rem;
    overflow: hidden;
    transition: all 0.3s;
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }

  .callout-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    background: rgba(15,25,35,0.8);
  }

  .callout-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: var(--accent);
    opacity: 0.6;
    transition: opacity 0.3s;
  }

  .callout-card:hover::before {
    opacity: 1;
  }

  .callout-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, var(--accent), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .callout-card:hover .callout-glow {
    opacity: 0.03;
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .callout-real {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 2px;
    opacity: 0.45;
    text-transform: uppercase;
    text-decoration: line-through;
    text-decoration-color: rgba(255,70,85,0.4);
  }

  .callout-arrow {
    color: var(--val-red);
    font-size: 0.9rem;
    opacity: 0.6;
  }

  .callout-squad {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .callout-body {
    margin-bottom: 1rem;
  }

  .callout-explanation {
    font-size: 0.85rem;
    line-height: 1.6;
    opacity: 0.65;
    font-weight: 500;
  }

  .callout-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .callout-coined {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.65rem;
