      { from: "TJC", color: "#17ecc2", time: "10:16 PM", text: "CRASHOUT" },
      { from: "GOOD CHILL NIGHT", color: "#f5d623", time: "10:16 PM", text: "he's fine" },
      { from: "TJC", color: "#17ecc2", time: "10:16 PM", text: "CRASHOUT" },
