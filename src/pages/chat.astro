      { from: "TJC", color: "#17ecc2", time: "10:47 PM", text: "wait" },
      { from: "TJC", color: "#17ecc2", time: "10:47 PM", text: "now I have no money for 3 rounds" },
      { from: "GOOD CHILL NIGHT", color: "#f5d623", time: "10:47 PM", text: "I thought we were saving" },
