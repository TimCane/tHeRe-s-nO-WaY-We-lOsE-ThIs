      { from: "DOODLLEUS", color: "#c742f5", time: "10:42 PM", text: "*buys vandal*" },
      { from: "PRETTY MOUTH BOY", color: "#f5a623", time: "10:42 PM", text: "*buys vandal*" },
      { from: "NEILATRON", color: "#7aff4a", time: "10:42 PM", text: "*buys vandal*" },
      { from: "GOOD CHILL NIGHT", color: "#f5d623", time: "10:43 PM", text: "*buys vandal*" },
      { from: "TJC", color: "#17ecc2", time: "10:43 PM", text: "I'm the only one who saved" },
      { from: "TJC", color: "#17ecc2", time: "10:43 PM", text: "I have a classic" },
