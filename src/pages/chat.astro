      { from: "NEILATRON", color: "#7aff4a", time: "11:03 PM", text: "wait you've been alt tabbed?" },
      { from: "PRETTY MOUTH BOY", color: "#f5a623", time: "11:03 PM", text: "only for like 6 rounds" },
