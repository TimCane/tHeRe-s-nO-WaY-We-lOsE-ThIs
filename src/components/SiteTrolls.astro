<script is:inline>
(function() {
  // Don't run trolls during loading
  var trollReady = false;
  setTimeout(function() { trollReady = true; }, 3500);

  /* ==================== 1. TAB TITLE TROLL ==================== */
  var originalTitle = document.title;
  var altTitles = [
    'COME BACK WE\'RE LOSING',
    'DOODLLEUS IS CARRYING WITHOUT YOU',
    'PRETTY MOUTH MAN ALT-TABBED TOO',
    'THE GAMING CHAIR MISSES YOU',
    'CHILL GOOD NIGHT IS SITE ADJACENT TO YOUR TAB',
