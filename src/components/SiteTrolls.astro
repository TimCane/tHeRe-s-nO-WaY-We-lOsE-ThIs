    'CRASHOUT CRASHOUT CRASHOUT',
    'TJC SAID HE\'D DO EXACTLY ONE WITHOUT YOU',
    'THE ODIN PROTOCOL REQUIRES YOUR PRESENCE'
  ];

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      document.title = altTitles[Math.floor(Math.random() * altTitles.length)];
    } else {
      document.title = originalTitle;
    }
  });

  /* ==================== 2. FAKE NOTIFICATIONS ==================== */
  var notifContainer = document.getElementById('troll-notifications');
  var notifications = [
    { type: 'SYSTEM', color: '#ff4655', text: 'RANK UPDATE: Gold 3 → Gold 2. Again.' },
    { type: 'PARTY', color: '#c742f5', text: 'Doodlleus has disconnected. Gaming chair lost power.' },
    { type: 'PARTY', color: '#f5a623', text: 'Pretty Mouth Man is now playing Factorio.' },
    { type: 'PARTY', color: '#17ecc2', text: 'TJC has equipped the Wasteland Vandal. God help us.' },
    { type: 'PARTY', color: '#f5d623', text: 'Chill Good Night says: "Mayb"' },
    { type: 'PARTY', color: '#7aff4a', text: 'Neilatron has fallen asleep in the lobby.' },
    { type: 'SYSTEM', color: '#ff4655', text: 'VALORANT has detected you are hardstuck.' },
    { type: 'ALERT', color: '#17ecc2', text: 'ACE WATCH UPDATE: Still 0 aces. The vigil continues.' },
    { type: 'PARTY', color: '#c742f5', text: 'Doodlleus: "Sploink?"' },
    { type: 'PARTY', color: '#17ecc2', text: 'TJC: "I could do exactly one"' },
    { type: 'SYSTEM', color: '#ff4655', text: 'ODIN PROTOCOL has been activated by the squad.' },
    { type: 'ALERT', color: '#f5a623', text: 'Pretty Mouth Man has minimized Valorant.' },
    { type: 'PARTY', color: '#f5d623', text: 'Chill Good Night has placed a turret. That\'s all she\'s doing.' },
    { type: 'SYSTEM', color: '#ff4655', text: 'WARNING: No one on your team knows a single lineup.' },
    { type: 'PARTY', color: '#7aff4a', text: 'Neilatron: "aye"' },
    { type: 'ALERT', color: '#17ecc2', text: 'TJC bait rez\'d someone. Survival rate: 12%.' },
    { type: 'SYSTEM', color: '#c742f5', text: 'Doodlleus: "tHeRe\'s nO wAy We LoSe ThIs" — GG.' },
    { type: 'SYSTEM', color: '#ff4655', text: 'ECONOMY ALERT: The squad has $200 combined.' },
    { type: 'PARTY', color: '#f5a623', text: 'Pretty Mouth Man: "not a gamer anymore" (queuing up)' },
    { type: 'SYSTEM', color: '#ff4655', text: 'Your aim has been reported to the authorities.' },
  ];

  function showNotification() {
    if (!trollReady || !notifContainer) return;
    var n = notifications[Math.floor(Math.random() * notifications.length)];
    var el = document.createElement('div');
    el.className = 'troll-notif';
    el.style.setProperty('--notif-color', n.color);
    el.innerHTML = '<div class="notif-header"><span class="notif-type">' + n.type + '</span><span class="notif-time">JUST NOW</span></div><div class="notif-body">' + n.text + '</div>';
    notifContainer.appendChild(el);

    // Remove after animation
    setTimeout(function() {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 5500);

    // Keep max 3
    while (notifContainer.children.length > 3) {
      notifContainer.removeChild(notifContainer.children[0]);
    }
  }

  // First notification after 15-30s, then every 20-45s
  setTimeout(function() {
    showNotification();
    setInterval(function() {
      if (Math.random() < 0.7) showNotification();
    }, 20000 + Math.random() * 25000);
  }, 15000 + Math.random() * 15000);

  /* ==================== 3. UN-CLOSABLE ODIN POPUP ==================== */
  var odinPopup = document.getElementById('odin-popup');
  var odinClose = document.getElementById('odin-close');
  var odinYes = document.getElementById('odin-yes');
  var odinNo = document.getElementById('odin-no');
  var odinShown = sessionStorage.getItem('odin-shown');
  var mouseX = 0, mouseY = 0;

  document.addEventListener('mousemove', function(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  // Show after 60-120s on the site (once per session)
  if (!odinShown) {
    setTimeout(function() {
      if (!trollReady) return;
      odinPopup.classList.add('active');
      sessionStorage.setItem('odin-shown', '1');
    }, 60000 + Math.random() * 60000);
  }

  // The close button dodges the mouse
  if (odinClose) {
    odinClose.addEventListener('mouseenter', function() {
      var rect = odinClose.parentElement.getBoundingClientRect();
      var maxX = rect.width - 30;
      var maxY = rect.height - 30;
      var newX = Math.random() * maxX;
      var newY = Math.random() * maxY;
      odinClose.style.position = 'absolute';
      odinClose.style.left = newX + 'px';
      odinClose.style.top = newY + 'px';
    });
  }

  // "No thanks" also dodges
  if (odinNo) {
    odinNo.addEventListener('mouseenter', function() {
      var parent = odinNo.parentElement;
      var rect = parent.getBoundingClientRect();
      odinNo.style.transform = 'translateX(' + (Math.random() * 100 - 50) + 'px) translateY(' + (Math.random() * 40 - 20) + 'px)';
    });
  }

  // "Yes" closes and shows a notification
  if (odinYes) {
    odinYes.addEventListener('click', function() {
      odinPopup.classList.remove('active');
      setTimeout(function() {
        var el = document.createElement('div');
        el.className = 'troll-notif';
        el.style.setProperty('--notif-color', '#ff4655');
        el.innerHTML = '<div class="notif-header"><span class="notif-type">ODIN PROTOCOL</span><span class="notif-time">NOW</span></div><div class="notif-body">You are now subscribed. An Odin will be purchased on your behalf every round. There is no unsubscribe.</div>';
        if (notifContainer) notifContainer.appendChild(el);
        setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 6000);
      }, 500);
    });
  }

  /* ==================== 4. CLIPBOARD HIJACK ==================== */
  document.addEventListener('copy', function(e) {
    // 40% chance of hijacking
    if (Math.random() < 0.4) {
      var hijacks = [
        'CRASHOUT',
        'purchance',
        'this is why im the viper',
        'ODIN PROTOCOL ACTIVATED',
        'im up for losing some rr',
        'Sploink?',
        'not a gamer anymore',
        'mayb',
        'FUCK YOU CHILL GOOD NIGHT',
        'aye',
      ];
      e.preventDefault();
      e.clipboardData.setData('text/plain', hijacks[Math.floor(Math.random() * hijacks.length)]);
    }
  });

  /* ==================== 5. SLOW PAGE ROTATION ==================== */
  var currentRotation = 0;
  var rotationInterval = setInterval(function() {
    if (!trollReady) return;
    currentRotation += 0.1;
    if (currentRotation > 3) {
      // Reset after getting noticeable enough
      clearInterval(rotationInterval);
      setTimeout(function() {
        document.body.style.transition = 'transform 1s ease';
        document.body.style.transform = 'rotate(0deg)';
        currentRotation = 0;
        // Start again after a while
        setTimeout(function() {
          rotationInterval = setInterval(function() {
            currentRotation += 0.1;
            document.body.style.transform = 'rotate(' + currentRotation + 'deg)';
            if (currentRotation > 3) clearInterval(rotationInterval);
          }, 30000);
        }, 120000);
      }, 3000);
      return;
    }
    document.body.style.transition = 'transform 2s ease';
    document.body.style.transform = 'rotate(' + currentRotation + 'deg)';
  }, 30000);

  /* ==================== 6. FAKE LOADING SCREEN ==================== */
  var fakeLoading = document.getElementById('fake-loading');
  var fakeLoadingText = document.getElementById('fake-loading-text');
  var fakeLoadingFill = document.getElementById('fake-loading-fill');
  var fakeLoadingPercent = document.getElementById('fake-loading-percent');
  var fakeLoadingShown = sessionStorage.getItem('fake-loading-shown');

  var loadingMessages = [
    'DOWNLOADING AIM...',
    'INSTALLING GAME SENSE...',
    'LOADING LINEUPS... ERROR: NONE FOUND',
    'BUFFERING SKILL...',
    'IMPORTING CROSSHAIR SETTINGS...',
    'CALIBRATING GAMING CHAIR...',
    'SYNCING WITH ODIN PROTOCOL...',
  ];

  function showFakeLoading() {
    if (!fakeLoading || !trollReady) return;
    var msg = loadingMessages[Math.floor(Math.random() * loadingMessages.length)];
    fakeLoadingText.textContent = msg;
    fakeLoadingFill.style.width = '0%';
    fakeLoadingPercent.textContent = '0%';
    fakeLoading.classList.add('active');

    var progress = 0;
    var loadInterval = setInterval(function() {
      // Gets exponentially slower as it approaches 99%
      var increment = Math.max(0.1, (100 - progress) * 0.08);
      progress = Math.min(99, progress + increment);
      fakeLoadingFill.style.width = progress + '%';
      fakeLoadingPercent.textContent = Math.floor(progress) + '%';

      if (progress >= 98.5) {
        clearInterval(loadInterval);
        // Stuck at 99% for 3 seconds then dismiss
        fakeLoadingPercent.textContent = '99%';
        fakeLoadingFill.style.width = '99%';
        setTimeout(function() {
          fakeLoadingText.textContent = 'DOWNLOAD FAILED. SKILL NOT FOUND.';
          fakeLoadingPercent.textContent = 'ERROR';
          fakeLoadingFill.style.background = 'var(--val-red)';
          setTimeout(function() {
            fakeLoading.classList.remove('active');
            fakeLoadingFill.style.background = '';
          }, 2000);
        }, 3000);
      }
    }, 100);
  }

  // Show once per session, after 90-180s
  if (!fakeLoadingShown) {
    setTimeout(function() {
      showFakeLoading();
      sessionStorage.setItem('fake-loading-shown', '1');
    }, 90000 + Math.random() * 90000);
  }

  /* ==================== 7. CURSOR SWARM ==================== */
  var cursorSwarm = document.getElementById('cursor-swarm');
  var fakeCursors = cursorSwarm ? cursorSwarm.querySelectorAll('.fake-cursor') : [];
  var cursorPositions = [];
  var swarmActive = false;

  // Initialize positions
  for (var i = 0; i < fakeCursors.length; i++) {
    cursorPositions.push({ x: -100, y: -100 });
  }

  // Track real mouse with lerp for fake cursors
  var realMX = -100, realMY = -100;
  document.addEventListener('mousemove', function(e) {
    realMX = e.clientX;
    realMY = e.clientY;
  });

  function updateFakeCursors() {
    if (!swarmActive) { requestAnimationFrame(updateFakeCursors); return; }
    for (var i = 0; i < fakeCursors.length; i++) {
      var lerpSpeed = parseFloat(fakeCursors[i].getAttribute('data-lerp')) || 0.05;
      var orbit = parseFloat(fakeCursors[i].getAttribute('data-orbit')) || 30;
      cursorPositions[i].x += (realMX - cursorPositions[i].x) * lerpSpeed;
      cursorPositions[i].y += (realMY - cursorPositions[i].y) * lerpSpeed;
      // Orbit around the target position so they spread out
      var angle = Date.now() * 0.001 * (1 + i * 0.3) + i * (Math.PI * 2 / fakeCursors.length);
      var offsetX = Math.sin(angle) * orbit;
      var offsetY = Math.cos(angle) * orbit;
      fakeCursors[i].style.left = (cursorPositions[i].x + offsetX) + 'px';
      fakeCursors[i].style.top = (cursorPositions[i].y + offsetY) + 'px';
    }
    requestAnimationFrame(updateFakeCursors);
  }
  requestAnimationFrame(updateFakeCursors);

  // Activate cursor swarm after 25-60s, lasts 30-60s, then repeats
  function startSwarm() {
    if (window.innerWidth < 768) return;
    swarmActive = true;
    cursorSwarm.classList.add('active');

    // Initialize fake cursor positions to current mouse
    for (var i = 0; i < cursorPositions.length; i++) {
      cursorPositions[i].x = realMX;
      cursorPositions[i].y = realMY;
    }

    // Show a notification
    var el = document.createElement('div');
    el.className = 'troll-notif';
    el.style.setProperty('--notif-color', '#c742f5');
    el.innerHTML = '<div class="notif-header"><span class="notif-type">SYSTEM</span><span class="notif-time">NOW</span></div><div class="notif-body">CURSOR MULTIPLIER ACTIVATED. You now have 6 cursors. You\'re welcome.</div>';
    if (notifContainer) notifContainer.appendChild(el);
    setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 6000);

    // Deactivate after 30-60s, then schedule next swarm
    setTimeout(function() {
      swarmActive = false;
      cursorSwarm.classList.remove('active');
      // Next swarm in 60-180s
      setTimeout(function() {
        if (trollReady) startSwarm();
      }, 60000 + Math.random() * 120000);
    }, 30000 + Math.random() * 30000);
  }

  setTimeout(function() {
    if (trollReady) startSwarm();
  }, 25000 + Math.random() * 35000);

  /* ==================== 8. RANDOM UPSIDE DOWN (1% chance) ==================== */
  if (Math.random() < 0.01) {
    document.addEventListener('DOMContentLoaded', function() {
      document.body.style.transform = 'rotate(180deg)';
      document.body.style.transformOrigin = 'center center';
    });
  }

  /* ==================== 9. EXIT INTENT POPUP ==================== */
  var exitPopup = document.getElementById('exit-popup');
  var exitShown = false;

  document.addEventListener('mouseleave', function(e) {
    if (e.clientY < 5 && !exitShown && trollReady) {
      exitShown = true;
      exitPopup.classList.add('active');
    }
  });

  var exitStay = document.getElementById('exit-stay');
  var exitLeave = document.getElementById('exit-leave');

  if (exitStay) {
    exitStay.addEventListener('click', function() {
      exitPopup.classList.remove('active');
    });
  }

  // "Leave" button shows second confirmation, then closes
  if (exitLeave) {
    var leaveClicks = 0;
    exitLeave.addEventListener('click', function() {
      leaveClicks++;
      if (leaveClicks === 1) {
        exitLeave.textContent = 'Are you REALLY sure?';
      } else if (leaveClicks === 2) {
        exitLeave.textContent = 'The squad will never forgive you';
      } else if (leaveClicks === 3) {
        exitLeave.textContent = 'Fine. Go.';
      } else {
        exitPopup.classList.remove('active');
      }
    });
  }

  /* ==================== 10. HIDDEN BACKGROUND RICKROLL ==================== */
  var bgRickroll = document.getElementById('bg-rickroll');
  var bgRickrollStarted = false;
  var bgRickrollInterval = null;

  if (bgRickroll) {
    bgRickroll.volume = 0.04; // Very quiet

    document.addEventListener('visibilitychange', function() {
      if (document.hidden) {
        // Tab is hidden — start the sneaky rickroll after a short delay
        if (!bgRickrollStarted) {
          bgRickrollStarted = true;
          // Wait 5s before starting, to make sure they've actually left
          bgRickrollInterval = setTimeout(function() {
            playSnippet();
          }, 5000);
        }
      } else {
        // Tab is visible — stop immediately
        if (bgRickrollInterval) {
          clearTimeout(bgRickrollInterval);
          bgRickrollInterval = null;
        }
        bgRickroll.pause();
      }
    });

    function playSnippet() {
      if (!document.hidden) return; // They came back, abort

      // Pick a random spot in the video (first 2 minutes)
      bgRickroll.currentTime = Math.random() * 120;
      bgRickroll.play().catch(function() {});

      // Play for 3-4 seconds, then pause
      var duration = 3000 + Math.random() * 1000;
      setTimeout(function() {
        bgRickroll.pause();
        // If still hidden, schedule another snippet in 15-30s
        if (document.hidden) {
          bgRickrollInterval = setTimeout(function() {
            playSnippet();
          }, 15000 + Math.random() * 15000);
        }
      }, duration);
    }
  }

})();
</script>
