<!--
  Shared styles and scripts for all player profile pages.
  Include this component once in each player page to get:
  - Entrance animation overlay
  - Parallax hero banner
  - Achievement badges section
  - Player stats grid
  - Player detail section (bio, playstyle, highlights, images)
  - Responsive breakpoints
-->

<style is:global>
  /* ===== ENTRANCE ANIMATION ===== */
  .entrance-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: var(--val-darker);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: entranceFade 0.5s ease 1.5s forwards;
    pointer-events: none;
  }
  .entrance-content { text-align: center; animation: entranceSlide 0.8s ease; }
  .entrance-agent {
    font-size: 0.7rem;
    letter-spacing: 6px;
    opacity: 0.4;
    font-weight: 600;
    animation: entrancePop 0.3s ease 0.2s both;
  }
  .entrance-name {
    font-size: clamp(3rem, 12vw, 8rem);
    font-weight: 700;
    letter-spacing: 8px;
    line-height: 0.9;
    animation: entrancePop 0.4s ease 0.4s both;
    text-shadow: 0 0 60px currentColor;
  }
  .entrance-role {
    font-size: 0.8rem;
    letter-spacing: 4px;
    opacity: 0.3;
    margin-top: 1rem;
    animation: entrancePop 0.3s ease 0.6s both;
  }

  @keyframes entrancePop {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes entranceSlide {
    from { transform: scale(1.1); }
    to { transform: scale(1); }
  }
  @keyframes entranceFade {
    to { opacity: 0; visibility: hidden; }
  }

  /* ===== PARALLAX HERO ===== */
  .parallax-bg img { transition: transform 0.1s linear; }

  /* ===== PLAYER HERO ===== */
  .player-hero { position: relative; height: 70vh; display: flex; align-items: flex-end; overflow: hidden; }
  .player-hero .hero-bg { position: absolute; inset: 0; }
  .player-hero .hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .player-hero .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10,16,24,0.3) 0%, rgba(10,16,24,0.9) 80%, var(--val-darker) 100%),
      linear-gradient(90deg, rgba(10,16,24,0.6) 0%, transparent 60%);
  }
  .player-hero .hero-content { position: relative; z-index: 2; padding: 4rem; }
  .player-hero .back-link {
    display: inline-block;
    color: var(--val-cream);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 3px;
    opacity: 0.5;
    margin-bottom: 2rem;
    transition: all 0.3s;
  }
  .player-hero .back-link:hover { opacity: 1; color: var(--accent); }
  .player-agents { font-size: 0.75rem; letter-spacing: 4px; color: var(--accent); font-weight: 700; }
  .player-name {
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 700;
    letter-spacing: 6px;
    line-height: 0.9;
    margin: 0.5rem 0;
  }
  .player-role { font-size: 0.9rem; letter-spacing: 4px; opacity: 0.4; }
  .player-quote {
    margin-top: 1.5rem;
    font-size: 1.2rem;
    font-style: italic;
    opacity: 0.6;
    letter-spacing: 1px;
  }

  /* ===== ACHIEVEMENT BADGES ===== */
  .badges-section {
    padding: 3rem 4rem;
    border-bottom: 1px solid rgba(236,232,225,0.05);
  }
  .badges-title {
    font-size: 0.7rem;
    letter-spacing: 4px;
    color: var(--accent);
    font-weight: 700;
    text-align: center;
    margin-bottom: 2rem;
  }
  .badges-grid {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
  }
  .badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.2rem 1.5rem;
    background: rgba(236,232,225,0.03);
    border: 1px solid rgba(236,232,225,0.06);
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
    transition: all 0.3s;
    min-width: 150px;
  }
  .badge:hover {
    border-color: var(--badge-color);
    background: rgba(236,232,225,0.06);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3), 0 0 20px color-mix(in srgb, var(--badge-color) 15%, transparent);
  }
  .badge-icon { font-size: 1.5rem; color: var(--badge-color); text-shadow: 0 0 10px var(--badge-color); }
  .badge-name { font-size: 0.6rem; letter-spacing: 2px; font-weight: 700; text-align: center; }
  .badge-desc { font-size: 0.55rem; letter-spacing: 1px; opacity: 0.4; text-align: center; }

  /* ===== PLAYER STATS ===== */
  .player-stats {
    padding: 4rem;
    border-top: 1px solid rgba(236,232,225,0.05);
    border-bottom: 1px solid rgba(236,232,225,0.05);
  }
  .stats-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 2rem;
  }
  .stat-block { text-align: center; }
  .stat-value { display: block; font-size: 2.5rem; font-weight: 700; color: var(--accent); }
  .stat-key {
    display: block;
    font-size: 0.6rem;
    letter-spacing: 3px;
    opacity: 0.4;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  /* ===== PLAYER DETAIL ===== */
  .player-detail { padding: 6rem 4rem; max-width: 1200px; margin: 0 auto; }
  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .detail-section { margin-bottom: 3rem; }
  .detail-section h2 {
    font-size: 0.8rem;
    letter-spacing: 4px;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .detail-section p { font-size: 1.05rem; line-height: 1.8; opacity: 0.7; }
  .highlights { list-style: none; }
  .highlights li {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(236,232,225,0.05);
    font-size: 0.95rem;
    opacity: 0.7;
    padding-left: 1.5rem;
    position: relative;
  }
  .highlights li::before {
    content: '//';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .detail-images { display: flex; flex-direction: column; gap: 1.5rem; }
  .detail-img-main {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
  }
  .detail-img-extra {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    opacity: 0.7;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: repeat(3, 1fr); }
    .detail-grid { grid-template-columns: 1fr; }
    .player-hero .hero-content { padding: 2rem; }
    .player-detail { padding: 4rem 2rem; }
    .badges-section { padding: 2rem 1.5rem; }
    .badge { min-width: 120px; }
  }
</style>

<script>
  // Parallax effect on hero banner
  const parallaxBg = document.getElementById('parallax-bg');
  if (parallaxBg) {
    const img = parallaxBg.querySelector('img');
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const heroHeight = parallaxBg.parentElement?.offsetHeight || 600;
      if (scrollY < heroHeight && img) {
        img.style.transform = `translateY(${scrollY * 0.3}px) scale(1.1)`;
      }
    });
  }
</script>
