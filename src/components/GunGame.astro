<!-- TEAM GUN GAME -->
<section class="gun-game" id="gungame">
  <div class="section-header">
    <span class="section-tag">// 007</span>
    <h2>TEAM GUN GAME</h2>
  </div>
  <p class="gun-game-sub">Our custom game mode. Everyone must get a kill before the team moves to the next gun. Knife kill = skip a gun. This is law.</p>

  <div class="gun-ladder">
    <div class="gun-step" style="--step: 1"><span class="gun-num">01</span><span class="gun-name">ANY PISTOL</span><span class="gun-note">Classic / Ghost / Sheriff — dealer's choice</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 2"><span class="gun-num">02</span><span class="gun-name">STINGER</span><span class="gun-note">The second round rush weapon of choice</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 3"><span class="gun-num">03</span><span class="gun-name">BULLDOG</span><span class="gun-note">Three-round burst and a prayer</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 4"><span class="gun-num">04</span><span class="gun-name">MARSHAL</span><span class="gun-note">Baby's first sniper</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 5"><span class="gun-num">05</span><span class="gun-name">SPECTRE</span><span class="gun-note">Run and gun's finest</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 6"><span class="gun-num">06</span><span class="gun-name">GUARDIAN</span><span class="gun-note">For people who think they have aim</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 7"><span class="gun-num">07</span><span class="gun-name">OUTLAW</span><span class="gun-note">Pretty Mouth Boy's round 2 weapon of mass destruction</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 8"><span class="gun-num">08</span><span class="gun-name">OPERATOR</span><span class="gun-note">4700 credits of commitment issues</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 9"><span class="gun-num">09</span><span class="gun-name">BUCKY</span><span class="gun-note">Right-click and hope</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 10"><span class="gun-num">10</span><span class="gun-name">PHANTOM</span><span class="gun-note">The sensible choice</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 11"><span class="gun-num">11</span><span class="gun-name">ARES</span><span class="gun-note">Odin's little brother</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 12"><span class="gun-num">12</span><span class="gun-name">JUDGE</span><span class="gun-note">Hide in a corner. No shame.</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 13"><span class="gun-num">13</span><span class="gun-name">VANDAL</span><span class="gun-note">TJC uses Wasteland Vandal. Unironically.</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step" style="--step: 14"><span class="gun-num">14</span><span class="gun-name">ODIN</span><span class="gun-note">The squad's weapon of choice. Always.</span></div>
    <div class="gun-connector"></div>
    <div class="gun-step final" style="--step: 15"><span class="gun-num">15</span><span class="gun-name">KNIFE</span><span class="gun-note">The final boss. The ultimate disrespect.</span></div>
  </div>

  <div class="gun-rules">
    <div class="gun-rule">
      <span class="rule-icon">&#9670;</span>
      <span>ALL 5 players must get a kill before the team moves up</span>
    </div>
    <div class="gun-rule">
      <span class="rule-icon">&#9670;</span>
      <span>Knife kill at any point = SKIP the current gun</span>
    </div>
    <div class="gun-rule">
      <span class="rule-icon">&#9670;</span>
      <span>No exceptions. No mercy. No lineups (obviously).</span>
    </div>
  </div>

  <div class="gun-legend">
    <div class="legend-card">
      <div class="legend-title">THE LOTUS INCIDENT</div>
      <div class="legend-body">
        <span class="legend-num count-up" data-target="4">0</span>
        <span class="legend-text">KNIFE KILLS IN A SINGLE ROUND</span>
      </div>
      <p class="legend-desc">The squad got 4 knife kills in one round on Lotus. It was the greatest moment in team history. Nothing before or since has come close. We peaked. It's all downhill from here.</p>
    </div>
  </div>
</section>

