  }

  @keyframes excuseGlitch {
    0%, 90%, 100% { opacity: 1; transform: none; }
    91% { opacity: 0.7; transform: skewX(-2deg); text-shadow: -3px 0 #17ecc2, 3px 0 #ff4655; }
    93% { opacity: 1; transform: skewX(1deg); text-shadow: 2px 0 #ff4655, -2px 0 #17ecc2; }
    95% { opacity: 0.8; transform: skewX(-1deg); }
    97% { opacity: 1; transform: none; }
  }

  .excuse-btn {
    display: inline-block;
    margin-top: 2rem;
