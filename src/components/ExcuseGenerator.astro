<!-- WHY WE LOST EXCUSE GENERATOR -->
<section class="excuse-gen" id="excuses">
  <div class="section-header">
    <span class="section-tag">// WHY WE LOST</span>
    <h2>EXCUSE GENERATOR</h2>
  </div>
  <div class="excuse-display">
    <p class="excuse-text glitch-text" id="excuse-text">Press the button. You know you need one.</p>
  </div>
  <button class="excuse-btn" id="excuse-btn">GENERATE EXCUSE</button>
</section>

<script>
  const excuses = [
    "Pretty Mouth Boy was in Factorio",
    "Doodlleus's gaming chair expired at 11pm",
    "Neilatron was still in spawn",
    "TJC bait rez'd everyone",
    "Chill Good Night was site adjacent",
    "Nobody bought util",
    "We all bought Odins and they had an Op",
    "TJC fell asleep",
    "The Wasteland Vandal energy was off",
    "Chill Good Night said 'Mayb' and we took that as a yes",
    "We tried lineups for the first time",
    "Pretty Mouth Boy's pipe burst again",
    "Neilatron said 'Aye' but meant 'nay'",
    "Someone called a stinger rush mid on round 12",
    "The vibes were off",
    "TJC said 'This is why im the viper' and then whiffed",
    "Chill Good Night's turret got more kills than the team combined",
    "We were winning until we started losing",
    "Doodlleus blue screened",
    "Pretty Mouth Boy said 'purchance' and we didn't know if that meant he was playing",
    "Doodlleus said 'Fuck you Chill Good Night' and she took it personally",
    "Chill Good Night existed and Doodlleus couldn't cope",
    "4 people forced when we agreed to save",
    "One person saved, four people forced, nobody had money for 3 rounds",
    "Someone said 'I thought we were saving' after full buying",
    "Chill Good Night yelled DEFUSE while we were attacking",
    "Doodlleus didn't check the minimap (again)"
  ];

  const excuseText = document.getElementById('excuse-text');
  const excuseBtn = document.getElementById('excuse-btn');

  if (excuseBtn && excuseText) {
    excuseBtn.addEventListener('click', () => {
      const excuse = excuses[Math.floor(Math.random() * excuses.length)];
      excuseText.style.opacity = '0';
      excuseText.style.transform = 'skewX(-5deg)';
      setTimeout(() => {
        excuseText.textContent = excuse;
        excuseText.style.opacity = '1';
        excuseText.style.transform = 'skewX(0deg)';
      }, 200);
    });
  }
</script>

<style>
